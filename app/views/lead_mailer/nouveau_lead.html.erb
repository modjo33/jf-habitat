<!DOCTYPE html>
<html>
<body style="font-family:system-ui,-apple-system,sans-serif;max-width:600px;margin:0 auto;background:#FAF7F2;padding:20px;">
  <div style="background:#0F2A44;color:white;padding:24px;border-radius:12px 12px 0 0;">
    <h1 style="margin:0;font-size:22px;">🔔 Nouveau lead JF Habitat</h1>
    <p style="margin:8px 0 0 0;color:rgba(255,255,255,0.7);font-size:14px;">Référence <%= @estimation.reference %></p>
  </div>

  <div style="background:white;padding:28px;">
    <h2 style="color:#0F2A44;font-size:18px;margin:0 0 16px 0;">Client</h2>
    <table style="width:100%;font-size:14px;">
      <tr><td style="padding:4px 0;color:#4A6785;">Nom</td><td style="padding:4px 0;font-weight:600;"><%= @estimation.nom %></td></tr>
      <tr><td style="padding:4px 0;color:#4A6785;">Email</td><td style="padding:4px 0;"><a href="mailto:<%= @estimation.email %>" style="color:#E6752A;"><%= @estimation.email %></a></td></tr>
      <tr><td style="padding:4px 0;color:#4A6785;">Téléphone</td><td style="padding:4px 0;"><a href="tel:<%= @estimation.telephone %>" style="color:#E6752A;"><%= @estimation.telephone %></a></td></tr>
      <% if @estimation.adresse.present? %>
      <tr><td style="padding:4px 0;color:#4A6785;">Adresse</td><td style="padding:4px 0;"><%= @estimation.adresse %>, <%= @estimation.code_postal %> <%= @estimation.ville %></td></tr>
      <% end %>
      <tr><td style="padding:4px 0;color:#4A6785;">Délai</td><td style="padding:4px 0;"><%= @estimation.delai_label %></td></tr>
      <tr><td style="padding:4px 0;color:#4A6785;">Chantier</td><td style="padding:4px 0;"><%= @estimation.type_chantier_label %></td></tr>
    </table>

    <% if @estimation.message.present? %>
      <div style="background:#FAF7F2;padding:14px;border-radius:8px;margin-top:16px;font-size:14px;color:#243D5C;">
        <strong>Message :</strong><br><%= simple_format @estimation.message %>
      </div>
    <% end %>

    <h2 style="color:#0F2A44;font-size:18px;margin:24px 0 12px 0;">Prestations estimées</h2>
    <% @estimation.estimation_lines.each do |line| %>
      <div style="padding:10px 12px;background:#FAF7F2;border-radius:8px;margin-bottom:6px;font-size:14px;">
        <div>
          <strong><%= line.piece %></strong> — <%= line.prestation_label %> (<%= line.gamme_label %>)<br>
          <span style="color:#4A6785;font-size:13px;"><%= line.surface %> m² × <%= number_to_currency(line.prix_unitaire, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
          <span style="float:right;font-weight:700;"><%= number_to_currency(line.total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
        </div>
      </div>
    <% end %>

    <div style="background:#0F2A44;color:white;padding:20px;border-radius:10px;margin-top:20px;">
      <table style="width:100%;">
        <tr>
          <td><%= @estimation.total_label %> estimé</td>
          <td style="text-align:right;font-size:26px;font-weight:800;color:#E6752A;"><%= number_to_currency(@estimation.total_ttc, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></td>
        </tr>
      </table>
    </div>

    <div style="margin-top:24px;text-align:center;">
      <a href="mailto:<%= @estimation.email %>" style="display:inline-block;background:#E6752A;color:white;padding:12px 24px;border-radius:8px;text-decoration:none;font-weight:600;">Répondre au client</a>
    </div>
  </div>
</body>
</html>
