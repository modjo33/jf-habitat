<%= render layout: "lead_mailer/enveloppe", locals: { estimation: @estimation, titre: "Devis signé", montant: @estimation.devis_total } do %>
  <p style="margin:0 0 14px 0;">Merci <%= @estimation.nom %> 🤝</p>
  <p style="margin:0 0 14px 0;">Votre devis <strong><%= @estimation.reference %></strong> a bien été signé le
    <%= @estimation.devis_signe_at&.strftime("%d/%m/%Y à %H:%M") %>.</p>
  <p style="margin:0 0 14px 0;">Vous le trouverez <strong>en pièce jointe</strong> (PDF), avec le détail des travaux et votre signature.</p>
  <p style="margin:0 0 14px 0;">Nous reviendrons vers vous pour convenir de la date de démarrage du chantier.
    Pour toute question, répondez simplement à cet e-mail.</p>
  <p style="margin:0;">À très bientôt,<br><strong>Johan — JF Habitat</strong></p>
<% end %>
