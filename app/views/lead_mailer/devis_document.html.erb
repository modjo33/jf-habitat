<%= render layout: "lead_mailer/enveloppe", locals: { estimation: @estimation, titre: "Devis", montant: @estimation.devis_total } do %>
  <% if @message.present? %>
    <%# Les retours à la ligne saisis dans l'admin deviennent de vrais
        paragraphes : les clients mail ignorent `white-space`. %>
    <%= simple_format(@message, { style: "margin:0 0 14px 0;" }) %>
  <% else %>
    <p style="margin:0 0 14px 0;">Bonjour <%= @estimation.nom %>,</p>
    <p style="margin:0 0 14px 0;">Suite à notre échange, veuillez trouver <strong>votre devis en pièce jointe</strong> (PDF), détaillant l'ensemble des travaux à réaliser.</p>
    <p style="margin:0 0 14px 0;">Je reste à votre disposition pour toute question ou ajustement.</p>
    <p style="margin:0 0 14px 0;">Bien cordialement,<br><strong>Johan — JF Habitat</strong></p>
  <% end %>
<% end %>
