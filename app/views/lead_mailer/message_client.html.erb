<%# Message libre écrit dans l'admin : même enveloppe que les devis (logo,
    ligne orange, pied d'identité). Le texte saisi devient de vrais paragraphes,
    échappés par simple_format ; les clients mail ignorent `white-space`. %>
<%= render layout: "lead_mailer/enveloppe", locals: { estimation: nil, titre: "Message", montant: 0 } do %>
  <%= simple_format(@corps, { style: "margin:0 0 14px 0;" }) %>
  <% if @documents.present? %>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FAF7F2;border-radius:10px;margin:6px 0 18px 0;">
      <tr><td style="padding:12px 16px;font-size:13px;color:#0F2A44;">
        <div style="font-size:11px;letter-spacing:1px;color:#4A6785;text-transform:uppercase;margin-bottom:4px;">Pièces jointes</div>
        <% @documents.each do |d| %><div>📎 <%= d.nom_piece_jointe %></div><% end %>
      </td></tr>
    </table>
  <% end %>
<% end %>
