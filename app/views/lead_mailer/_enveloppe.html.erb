<%# Enveloppe des mails de devis : la même identité que le PDF joint (logo,
    cartouche sable, ligne orange, pied d'identité). Tout est en styles inline,
    et jamais en `white-space` : Outlook et consorts l'ignorent. %>
<%
  ink       = "#0F2A44"
  ink_soft  = "#4A6785"
  accent    = "#E6752A"
  sand      = "#FAF7F2"
  societe   = ENV.fetch("LEGAL_COMPANY_NAME", "JF Habitat")
  telephone = ENV["BUSINESS_PHONE"].presence || ENV["LEGAL_PHONE"].presence
  email     = ENV["BUSINESS_EMAIL"].presence || ENV["LEGAL_EMAIL"].presence || "contact@jfhabitat.fr"
  siret     = ENV["LEGAL_SIRET"].presence
  logo      = attachments["logo.png"]
%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:<%= sand %>;padding:24px 12px;">
  <tr><td align="center">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#FFFFFF;border-radius:12px;overflow:hidden;font-family:Arial,Helvetica,sans-serif;">

      <%# En-tête : logo à gauche, cartouche à droite, comme le PDF %>
      <tr>
        <td style="padding:24px 28px 18px 28px;border-bottom:4px solid <%= accent %>;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td valign="middle" style="padding:0;">
                <% if logo %>
                  <img src="<%= logo.url %>" alt="<%= societe %>" width="150" style="display:block;width:150px;height:auto;border:0;">
                <% else %>
                  <span style="font-size:22px;font-weight:700;color:<%= ink %>;letter-spacing:.5px;">JF HABITAT</span>
                <% end %>
                <div style="font-size:12px;color:<%= ink_soft %>;margin-top:8px;">Artisan peintre · plaquiste · parqueteur</div>
              </td>
              <td valign="middle" align="right" style="padding:0;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="background:<%= sand %>;border-radius:8px;">
                  <tr><td style="padding:10px 14px;text-align:left;">
                    <div style="font-size:10px;letter-spacing:1.5px;color:<%= ink_soft %>;text-transform:uppercase;"><%= titre %></div>
                    <div style="font-size:15px;font-weight:700;color:<%= ink %>;margin-top:2px;"><%= estimation.reference %></div>
                    <div style="font-size:12px;color:<%= ink_soft %>;margin-top:2px;"><%= I18n.l(Date.current, format: "%d/%m/%Y") %></div>
                  </td></tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <%# Corps %>
      <tr>
        <td style="padding:26px 28px 8px 28px;font-size:15px;line-height:1.6;color:#243D5C;">
          <%= yield %>
        </td>
      </tr>

      <%# Pièce jointe + montant %>
      <% if montant.to_d.positive? %>
        <tr>
          <td style="padding:8px 28px 26px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:<%= sand %>;border-radius:10px;">
              <tr>
                <td style="padding:14px 16px;font-size:13px;color:<%= ink %>;">
                  📎 <strong>devis-jf-habitat-<%= estimation.reference %>.pdf</strong><br>
                  <span style="color:<%= ink_soft %>;"><%= estimation.devis_estimatif? ? "Devis estimatif détaillé en pièce jointe" : "Devis détaillé en pièce jointe" %></span>
                </td>
                <td align="right" style="padding:14px 16px;white-space:nowrap;">
                  <div style="font-size:11px;letter-spacing:1px;color:<%= ink_soft %>;text-transform:uppercase;">Total</div>
                  <div style="font-size:22px;font-weight:800;color:<%= accent %>;"><%= number_to_currency(montant, unit: "€", separator: ",", delimiter: " ", format: "%n %u", precision: 2) %></div>
                  <% unless estimation.tva_applicable? %>
                    <div style="font-size:11px;color:<%= ink_soft %>;">TVA non applicable, art. 293 B du CGI</div>
                  <% end %>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      <% end %>

      <%# Pied d'identité, comme le PDF %>
      <tr>
        <td style="padding:16px 28px 22px 28px;border-top:1px solid #EEE9E1;font-size:12px;line-height:1.6;color:<%= ink_soft %>;">
          <strong style="color:<%= ink %>;"><%= societe %></strong>
          <% if siret %> · SIRET <%= siret %><% end %><br>
          <% if telephone %><a href="tel:<%= telephone.gsub(/[^+\d]/, '') %>" style="color:<%= ink %>;text-decoration:none;"><%= telephone %></a> · <% end %>
          <a href="mailto:<%= email %>" style="color:<%= ink %>;text-decoration:none;"><%= email %></a>
          · <a href="https://www.jfhabitat.fr" style="color:<%= ink %>;text-decoration:none;">www.jfhabitat.fr</a>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
