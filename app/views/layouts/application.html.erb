<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Artisan peintre en Gironde (33) — peinture, parquet & placo · JF Habitat" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'Artisan peintre à Ayguemorte-les-Graves, en Gironde et sur Bordeaux Métropole : peinture, parquet, placo. Devis détaillé en ligne en 2 minutes, finitions soignées.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JF Habitat">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#2A2218">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "shared/seo_meta" %>
    <%= render "shared/analytics" %>

    <%# Polices auto-hébergées (cf. application.css) : préchargées pour que le
        titre s'affiche avec la bonne police dès le premier rendu. %>
    <%= preload_link_tag asset_path("fraunces-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag asset_path("inter-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%= yield :head %>

    <%= render "shared/favicon" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% fullscreen = content_for?(:fullscreen) %>
  <body class="font-body bg-sand text-ink antialiased" data-controller="rappel">
    <%= render "shared/navbar" unless fullscreen %>

    <% if notice %>
      <div class="fixed top-24 right-6 z-50 bg-emerald-600 text-white px-5 py-3 rounded-lg shadow-lg animate-slide-in">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="fixed top-24 right-6 z-50 bg-red-600 text-white px-5 py-3 rounded-lg shadow-lg animate-slide-in">
        <%= alert %>
      </div>
    <% end %>

    <%# pb-24 mobile : l'espace du bandeau d'action fixe (shared/contact_bar),
        sinon il masque le bas du footer. Le wizard (fullscreen) a son propre CTA. %>
    <main class="<%= fullscreen ? "" : "pb-24 md:pb-0" %>">
      <%= yield %>
    </main>

    <%= render "shared/footer" unless fullscreen %>
    <%= render "shared/contact_bar" unless fullscreen %>
    <%= render "shared/rappel_panel" %>
    <%= render "shared/cookie_banner" %>
  </body>
</html>
