<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Peintre, plaquiste & parqueteur en Gironde (33) — JF Habitat" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'Artisan peinture, placo et parquet à Ayguemorte-les-Graves, en Gironde et sur Bordeaux Métropole. Devis détaillé en ligne en 2 minutes, finitions soignées.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="JF Habitat">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#2A2218">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "shared/seo_meta" %>
    <%= render "shared/analytics" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/icon.png?v=2" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png?v=2">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-body bg-sand text-ink antialiased">
    <% fullscreen = content_for?(:fullscreen) %>
    <%= render "shared/navbar" unless fullscreen %>

    <% if notice %>
      <div class="fixed top-24 right-6 z-50 bg-emerald-600 text-white px-5 py-3 rounded-lg shadow-lg animate-slide-in">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="fixed top-24 right-6 z-50 bg-red-600 text-white px-5 py-3 rounded-lg shadow-lg animate-slide-in">
        <%= alert %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <%= render "shared/footer" unless fullscreen %>
    <%= render "shared/cookie_banner" %>
  </body>
</html>
