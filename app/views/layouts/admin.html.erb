<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Admin · JF Habitat</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2A2218">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="font-body bg-sand min-h-screen text-ink">
    <div class="min-h-screen flex">
      <!-- Sidebar -->
      <aside class="w-64 bg-ink text-sand flex flex-col">
        <div class="p-6 border-b border-sand/10">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-sand/10 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/>
              </svg>
            </div>
            <div>
              <div class="font-display text-xl tracking-tight leading-none">JF <em class="text-accent not-italic">Habitat</em></div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-sand/50 mt-1">Admin</div>
            </div>
          </div>
        </div>

        <%
          nav = ->(href, label, controller_match, badge: nil) do
            active = controller_match.include?(controller_name)
            klass = "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition hover:bg-sand/10 #{'bg-sand/10 text-sand' if active}"
            link_to href, class: klass do
              concat content_tag(:span, label, class: "flex-1")
              concat content_tag(:span, badge, class: "text-xs bg-accent text-sand px-2 py-0.5 rounded-full") if badge
            end
          end
        %>

        <nav class="flex-1 p-4 space-y-5 overflow-y-auto">
          <div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-sand/40 px-3 mb-2">Pipeline</div>
            <div class="space-y-1">
              <%= nav.(admin_root_path, "Dashboard", %w[dashboard]) %>
              <%= nav.(admin_clients_path, "Clients (CRM)", %w[clients client_notes], badge: Client.where(statut: %w[nouveau contacte rdv_pris devis_envoye]).count) %>
              <%= nav.(admin_estimations_path, "Estimations", %w[estimations], badge: Estimation.where(statut: "nouveau").count) %>
            </div>
          </div>

          <div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-sand/40 px-3 mb-2">Compta</div>
            <div class="space-y-1">
              <%= nav.(admin_declarations_path, "Déclarations", %w[declarations]) %>
              <%= nav.(admin_encaissements_path, "Encaissements", %w[encaissements]) %>
            </div>
          </div>

          <div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-sand/40 px-3 mb-2">Contenu</div>
            <div class="space-y-1">
              <%= nav.(admin_site_texts_path, "Textes du site", %w[site_texts]) %>
              <%= nav.(admin_media_slots_path, "Photos (emplacements)", %w[media_slots]) %>
              <%= nav.(admin_realisations_path, "Galerie réalisations", %w[realisations]) %>
            </div>
          </div>

          <div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-sand/40 px-3 mb-2">Configuration</div>
            <div class="space-y-1">
              <%= nav.(admin_tarifs_path, "Tarifs", %w[tarifs]) %>
            </div>
          </div>
        </nav>

        <div class="p-4 border-t border-sand/10">
          <%= link_to "Voir le site public ↗", root_path, target: "_blank", class: "block text-sm text-sand/60 hover:text-sand transition" %>
        </div>
      </aside>

      <div class="flex-1 flex flex-col">
        <main class="flex-1 p-8 overflow-x-hidden">
          <% if campagne_ads&.alerte? %>
            <% crit = campagne_ads.niveau == :critique %>
            <div class="mb-6 px-4 py-3 rounded-lg border flex items-center justify-between gap-4 <%= crit ? 'bg-red-50 border-red-300 text-red-800' : 'bg-accent-soft border-accent/40 text-ink' %>">
              <div class="text-sm">
                <span class="font-bold"><%= crit ? '⚠️ Campagne Google Ads — action requise' : '👀 Campagne Google Ads — à surveiller' %></span>
                <span class="mx-2">·</span>
                <% if campagne_ads.pourcentage >= 70 %>
                  Dépense à <strong><%= campagne_ads.pourcentage %> %</strong> du budget
                  (reste <strong><%= number_to_currency(campagne_ads.budget_restant, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></strong>,
                  ≈ <%= campagne_ads.jours_budget_restant %> j de diffusion).
                <% end %>
                <% if campagne_ads.jours_avant_validation && campagne_ads.jours_avant_validation <= 10 %>
                  Validation d'annonceur à faire dans <strong><%= campagne_ads.jours_avant_validation %> j</strong> (Kbis Switchloop).
                <% end %>
              </div>
              <%= link_to "Voir →", admin_root_path, class: "text-sm font-semibold shrink-0 hover:underline" %>
            </div>
          <% end %>
          <% if notice %>
            <div class="mb-6 bg-sauge-soft border border-sauge/30 text-ink px-4 py-3 rounded-lg"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="mb-6 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg"><%= alert %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
