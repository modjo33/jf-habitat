<% content_for :title, "Contact — JF Habitat, artisan en Gironde (33)" %>
<% content_for :description, "Contactez JF Habitat à Ayguemorte-les-Graves pour vos travaux de peinture, parquet et placo en Gironde et sur Bordeaux Métropole. Réponse sous 24h." %>

<%
  email     = ENV.fetch("BUSINESS_EMAIL", "contact@jfhabitat.fr")
  telephone = ENV.fetch("BUSINESS_PHONE", "[À compléter]")
  adresse   = ENV.fetch("BUSINESS_STREET", "[À compléter]")
  ville     = ENV.fetch("BUSINESS_CITY", "[À compléter]")
  cp        = ENV.fetch("BUSINESS_POSTAL_CODE", "")
  zone      = ENV.fetch("BUSINESS_AREA", "France")
  horaires  = ENV.fetch("BUSINESS_HOURS", "Lundi au vendredi · 8h–18h")
%>

<!-- HERO -->
<section class="relative bg-ink text-sand overflow-hidden">
  <div class="absolute inset-0 opacity-25">
    <%= image_tag stock_photo_url(:contact_ambiance, w: 2200, h: 800),
          alt: "",
          loading: "eager",
          class: "w-full h-full object-cover" %>
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/40 to-ink"></div>
  </div>
  <div class="relative max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32 text-center">
    <div class="eyebrow text-accent mb-5"><%= site_text("contact.hero.eyebrow", "Parlons de votre projet") %></div>
    <h1 class="h-display text-5xl lg:text-6xl text-sand mb-6">
      <%= site_text("contact.hero.title", "Contactez JF Habitat.") %>
    </h1>
    <p class="text-sand/70 text-lg max-w-xl mx-auto leading-relaxed">
      <%= site_text("contact.hero.body", "Une question, un projet, un rendez-vous ? Le plus rapide reste l'estimation en ligne — sinon écrivez-nous, nous répondons sous 24h.") %>
    </p>
  </div>
</section>

<section class="py-24 bg-sand">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="grid md:grid-cols-2 gap-8">
      <div class="card-premium p-9">
        <div class="eyebrow mb-4">Coordonnées</div>
        <h2 class="h-display text-3xl text-ink mb-7">Nous joindre directement</h2>

        <div class="space-y-6 text-ink-soft">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-accent-soft border border-accent/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-light mb-1">Téléphone</div>
              <%= link_to telephone, "tel:#{telephone.gsub(/\s/, '')}", class: "font-display text-xl text-ink hover:text-accent transition" %>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-accent-soft border border-accent/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-light mb-1">E-mail</div>
              <%= mail_to email, email, class: "font-display text-xl text-ink hover:text-accent transition" %>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-accent-soft border border-accent/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-light mb-1">Adresse</div>
              <p class="text-ink"><%= adresse %><br><%= "#{cp} #{ville}".strip %></p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-accent-soft border border-accent/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-light mb-1">Horaires</div>
              <p class="text-ink"><%= horaires %></p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-accent-soft border border-accent/20 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase tracking-widest text-ink-light mb-1">Zone d'intervention</div>
              <p class="text-ink"><%= zone %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-2xl shadow-premium min-h-[420px]">
        <%= image_tag stock_photo_url(:intro_ambiance, w: 1000, h: 1100),
              alt: "Ambiance intérieure JF Habitat",
              loading: "lazy",
              class: "absolute inset-0 w-full h-full object-cover" %>
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-9 text-sand">
          <div class="eyebrow text-accent mb-3">Le plus rapide</div>
          <h3 class="h-display text-3xl mb-4">Estimation en 2 minutes.</h3>
          <p class="text-sand/80 mb-7 leading-relaxed text-sm">
            Indiquez vos pièces, leurs surfaces, puis vos coordonnées —
            votre devis détaillé, avec son PDF, s'affiche dès la soumission.
            On vous rappelle sous 24h.
          </p>
          <%= link_to "Démarrer mon estimation", new_estimation_path, class: "btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</section>
