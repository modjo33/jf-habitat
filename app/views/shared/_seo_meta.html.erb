<%# Open Graph & Twitter Card %>
<% page_title       = content_for?(:title)       ? content_for(:title)       : "Peintre, plaquiste & parqueteur en Gironde (33) — JF Habitat" %>
<% page_description = content_for?(:description) ? content_for(:description) : "Artisan peinture, placo et parquet à Ayguemorte-les-Graves, en Gironde et sur Bordeaux Métropole. Devis détaillé en ligne en 2 minutes, finitions soignées." %>
<% page_url         = request.original_url %>
<% og_image         = content_for?(:og_image) ? content_for(:og_image) : "#{request.base_url}/og-image.png" %>

<meta property="og:type"        content="website">
<meta property="og:site_name"   content="JF Habitat">
<meta property="og:title"       content="<%= page_title %>">
<meta property="og:description" content="<%= page_description %>">
<meta property="og:url"         content="<%= page_url %>">
<meta property="og:image"       content="<%= og_image %>">
<meta property="og:locale"      content="fr_FR">

<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="<%= page_title %>">
<meta name="twitter:description" content="<%= page_description %>">
<meta name="twitter:image"       content="<%= og_image %>">

<link rel="canonical" href="<%= page_url.split('?').first %>">

<%# Schema.org LocalBusiness (référencement local Gironde / Bordeaux) %>
<script type="application/ld+json">
<%= raw({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://www.jfhabitat.fr/#business",
  "name": "JF Habitat",
  "description": "Artisan peintre à Ayguemorte-les-Graves. Travaux de peinture intérieure et extérieure, pose de parquet et placo-plâtre en Gironde et sur Bordeaux Métropole, en rénovation comme en neuf.",
  "url": "https://www.jfhabitat.fr",
  "telephone": ENV.fetch("BUSINESS_PHONE", "+33-X-XX-XX-XX-XX"),
  "email": ENV.fetch("BUSINESS_EMAIL", "contact@jfhabitat.fr"),
  "image": "#{request.base_url}/og-image.png",
  "priceRange": "€€",
  "currenciesAccepted": "EUR",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": ENV.fetch("BUSINESS_STREET", "À compléter"),
    "addressLocality": ENV.fetch("BUSINESS_CITY", "À compléter"),
    "postalCode": ENV.fetch("BUSINESS_POSTAL_CODE", "00000"),
    "addressRegion": "Gironde",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.7089,
    "longitude": -0.5483
  },
  "areaServed": ENV.fetch("BUSINESS_AREA", "France").split(",").map(&:strip),
  "knowsAbout": [ "Peinture intérieure et extérieure", "Pose de parquet", "Placo-plâtre et cloisons", "Rénovation", "Isolation" ],
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Peinture intérieure et extérieure", "areaServed": "Gironde" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pose et rénovation de parquet", "areaServed": "Gironde" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Placo-plâtre, cloisons et plafonds", "areaServed": "Gironde" } }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ],
      "opens": "08:00",
      "closes": "18:00"
    }
  ],
  "sameAs": [ ENV["FACEBOOK_URL"], ENV["INSTAGRAM_URL"], ENV["LINKEDIN_URL"] ].compact
}.to_json) %>
</script>
