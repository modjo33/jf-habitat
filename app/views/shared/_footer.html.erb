<footer class="bg-ink text-sand mt-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
    <div class="grid md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-11 h-11 bg-sand/10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <span class="font-display text-2xl tracking-tight leading-none">
            JF <em class="text-accent not-italic">Habitat</em>
          </span>
        </div>
        <p class="text-sand/60 max-w-md leading-relaxed">
          <%= site_text("footer.tagline", "Artisan peintre, plaquiste et parqueteur. Travaux de rénovation et de construction neuve, avec une exigence haut de gamme et le souci du détail.") %>
        </p>
      </div>

      <div>
        <h4 class="font-display text-lg mb-5">Prestations</h4>
        <ul class="space-y-3 text-sand/60 text-sm">
          <li><%= link_to "Peinture", services_path, class: "hover:text-accent transition" %></li>
          <li><%= link_to "Placo-plâtre", services_path, class: "hover:text-accent transition" %></li>
          <li><%= link_to "Parquet", services_path, class: "hover:text-accent transition" %></li>
          <li><%= link_to "Réalisations", realisations_path, class: "hover:text-accent transition" %></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display text-lg mb-5">Contact</h4>
        <ul class="space-y-3 text-sand/60 text-sm">
          <li><%= ENV.fetch("BUSINESS_AREA", "France") %></li>
          <% if ENV["BUSINESS_PHONE"].present? %>
            <li><%= link_to ENV["BUSINESS_PHONE"], "tel:#{ENV['BUSINESS_PHONE'].gsub(/\s/, '')}", class: "hover:text-accent transition" %></li>
          <% end %>
          <li><%= link_to "Nous écrire", contact_path, class: "hover:text-accent transition" %></li>
          <li><%= link_to "Estimation gratuite", new_estimation_path, class: "text-accent hover:underline" %></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-sand/10 mt-14 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-sand/40">
      <span>© <%= Date.current.year %> JF Habitat. Tous droits réservés.</span>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
        <li><%= link_to "Mentions légales", mentions_legales_path, class: "hover:text-sand transition" %></li>
        <li><%= link_to "Confidentialité", politique_confidentialite_path, class: "hover:text-sand transition" %></li>
        <li><%= link_to "CGU", cgu_path, class: "hover:text-sand transition" %></li>
      </ul>
    </div>
  </div>
</footer>
