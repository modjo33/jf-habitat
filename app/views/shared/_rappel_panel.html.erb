<%# Panneau « Être rappelé » : feuille en bas d'écran sur mobile, fenêtre
    centrée sur ordinateur. Rendu sur TOUTES les pages publiques (le wizard y
    renvoie depuis son écran contact) ; ouvert par n'importe quel
    data-action="rappel#open", le contrôleur Stimulus vivant sur <body>.
    z-[60] : au-dessus du bandeau cookies (z-50). %>
<div id="rappel-panel" data-rappel-target="panel" hidden class="fixed inset-0 z-[60]"
     data-action="keydown@window->rappel#keydown turbo:submit-end->rappel#submitted">
  <div class="absolute inset-0 bg-ink/50" data-action="click->rappel#close"></div>
  <div class="absolute bottom-0 left-0 right-0 md:bottom-auto md:top-1/2 md:left-1/2 md:right-auto md:-translate-x-1/2 md:-translate-y-1/2 md:w-[28rem] max-h-[92vh] overflow-y-auto bg-cream rounded-t-3xl md:rounded-2xl shadow-2xl p-6"
       role="dialog" aria-modal="true" aria-labelledby="rappel-titre">
    <div id="rappel-contenu">
      <%= render "shared/rappel_form", metier: params[:metier].presence, page: request.path %>
    </div>
  </div>
</div>
