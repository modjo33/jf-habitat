<% content_for :fullscreen, true %>
<% content_for :title, "Estimation gratuite peinture, placo, parquet en Gironde — JF Habitat" %>
<% content_for :description, "Estimez gratuitement vos travaux de peinture, placo ou parquet en Gironde. Devis détaillé en quelques questions, sans engagement. Artisan JF Habitat (Ayguemorte-les-Graves, 33)." %>

<%
  types_piece = EstimationLine::TYPES_PIECE.map { |k, v| [k, v[:label]] }
  gammes = [
    ["entree", "Entrée de gamme", "Finitions standards, matériaux courants"],
    ["milieu", "Milieu de gamme", "Bon rapport qualité-prix, finitions soignées"],
    ["haut",   "Haut de gamme",   "Matériaux premium, finitions impeccables"]
  ]
  travaux = [
    ["peinture_murs",       "Peinture des murs"],
    ["peinture_plafond",    "Peinture du plafond"],
    ["placo_cloison",       "Cloison placo"],
    ["placo_plafond",       "Plafond placo"],
    ["placo_bandes_enduit", "Bandes & enduit"],
    ["parquet_stratifie",   "Parquet stratifié"],
    ["parquet_contrecolle", "Parquet contrecollé"],
    ["parquet_massif",      "Parquet massif"]
  ]
  # Précisions (valeurs = libellés, compilées dans le message du lead)
  etats     = ["Surfaces saines", "Quelques reprises (trous, fissures)", "Dégradées (humidité, anciennes couches à retirer)"]
  peintures = ["Mate", "Velours", "Satin", "Lessivable (cuisine, salle de bain)"]
  teintes   = ["Une seule teinte", "Plusieurs teintes"]
  sols      = ["Sol nu / béton", "Ancien parquet", "Carrelage", "Moquette"]
  profils   = ["Propriétaire", "Locataire", "Professionnel / bailleur"]
  sources   = ["Bouche-à-oreille", "Recherche Google", "Réseaux sociaux", "J'ai déjà fait appel à vous", "Autre"]
%>

<%# `novalidate` est INDISPENSABLE, pas un détail de confort.
    Les champs de dimensions vivent dans des écrans masqués mais restent dans le
    formulaire, avec des contraintes `min`/`max`. Une hauteur saisie « 25 » au
    lieu de « 2,5 » rendait donc le formulaire invalide pour le navigateur, qui
    refusait `requestSubmit()` SANS RIEN AFFICHER (« An invalid form control
    with name='' is not focusable » en console) : le visiteur tapait le bouton
    final, rien ne se passait, il partait. La validation du parcours est faite
    par `wizard_controller`, écran par écran, avec des messages lisibles. %>
<%= form_with model: @estimation, url: estimation_path, method: :post, multipart: true,
      data: { controller: "wizard", action: "keydown->wizard#onKeydown" },
      html: { novalidate: true },
      class: "wizard-shell" do |f| %>

  <!-- Barre de progression -->
  <header class="wizard-topbar">
    <a href="<%= root_path %>" class="font-display text-lg text-ink">JF&nbsp;Habitat</a>
    <div class="flex-1 mx-4 h-1.5 bg-sand-dark rounded-full overflow-hidden">
      <div data-wizard-target="progressBar" class="h-full bg-accent rounded-full transition-all duration-300" style="width:0%"></div>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <span data-wizard-target="progressText" class="text-xs text-ink-light tabular-nums"></span>
      <button type="button" data-wizard-target="back" data-action="wizard#prev"
              class="text-sm font-semibold text-ink-soft hover:text-accent transition whitespace-nowrap">
        ←<span class="hidden sm:inline"> Retour</span>
      </button>
      <%# 80 % du trafic arrive du mobile et beaucoup de gens préfèrent appeler
          plutôt que remplir six écrans. Sans ce bouton, le tunnel n'offrait
          aucune sortie : remplir jusqu'au bout, ou partir. %>
      <% if business_phone_link %>
        <a href="<%= business_phone_link %>"
           class="flex items-center gap-1.5 shrink-0 border border-accent text-accent rounded-lg px-3 py-2
                  text-sm font-bold hover:bg-accent hover:text-sand transition"
           aria-label="Appeler <%= business_phone %>">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span class="hidden sm:inline whitespace-nowrap"><%= business_phone %></span>
          <%# Sous 360 px (vieux iPhone SE) le libellé écraserait la barre de
              progression : l'icône seule, sinon « Appeler ». %>
          <span class="sm:hidden max-[359px]:hidden">Appeler</span>
        </a>
      <% end %>
    </div>
  </header>

  <!-- Lignes assemblées (injectées par le contrôleur) + champs cachés -->
  <div data-wizard-target="lines" class="hidden"></div>

  <main class="wizard-stage">

    <!-- 1 · Type de chantier -->
    <section class="wizard-step" data-wizard-target="step" data-step="type_chantier" data-validate="card">
      <div class="wizard-eyebrow">Votre projet</div>
      <h2 class="wizard-question">Quel type de chantier ?</h2>
      <%# « Rénovation » est pré-sélectionnée : la quasi-totalité du trafic est
          de la rénovation, et l'écran 1 perdait 60 % des visiteurs — un choix
          déjà fait se confirme d'un tap, il ne se réfléchit pas. %>
      <div data-card-group data-auto-advance="true" class="wizard-cards">
        <%= f.hidden_field :type_chantier, value: "renovation" %>
        <button type="button" data-card data-value="renovation" data-selected="true" data-action="wizard#selectCard" class="wizard-card">
          <span class="wizard-card-title">Rénovation</span>
          <span class="wizard-card-sub">Logement existant à rénover</span>
        </button>
        <button type="button" data-card data-value="neuf" data-action="wizard#selectCard" class="wizard-card">
          <span class="wizard-card-title">Construction neuve</span>
          <span class="wizard-card-sub">Logement neuf ou support neuf</span>
        </button>
      </div>
      <%# Réassurance à l'entrée : c'est ici que 60 % du trafic payé repartait,
          sans aucun élément de confiance à l'écran. %>
      <div class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-xs text-ink-light">
        <span class="whitespace-nowrap">✓ Artisan local en Gironde</span>
        <span class="whitespace-nowrap">✓ Devis en 2 minutes</span>
        <span class="whitespace-nowrap">✓ Sans engagement</span>
      </div>
      <p data-wizard-target="error" class="wizard-error hidden"></p>
    </section>

    <!-- 2 · Quelles pièces (remplace « combien de pièces » + un écran de type par pièce) -->
    <section class="wizard-step hidden" data-wizard-target="step" data-step="pieces" data-validate="pieces">
      <div class="wizard-eyebrow">Votre logement</div>
      <%# Marge réduite : cet écran est le plus haut du tunnel, il doit tenir
          sans scroll sur un iPhone 13 (664 px utiles) — voir .wizard-stage. %>
      <h2 class="wizard-question !mb-3">Quelles pièces à traiter ?</h2>

      <%# Lignes volontairement compactes : 7 types + le bouton doivent tenir
          SANS scroll sur un iPhone (664 px utiles), sinon le « Continuer »
          passe sous la ligne de flottaison et le tunnel se bloque. %>
      <div class="w-full max-w-md space-y-1.5">
        <% types_piece.each do |key, label| %>
          <div class="flex items-center justify-between gap-3 px-3 py-1 bg-cream border border-border-warm rounded-lg transition"
               data-piece-row data-piece-type="<%= key %>" data-piece-label="<%= label %>">
            <span class="text-sm font-semibold text-ink text-left"><%= label %></span>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" data-action="wizard#decPiece"
                      class="w-8 h-8 rounded-lg border border-border-warm text-ink-soft text-base font-bold leading-none
                             hover:border-accent hover:text-accent transition" aria-label="Retirer">−</button>
              <span data-piece-count class="w-5 text-center tabular-nums font-display text-base text-ink">0</span>
              <button type="button" data-action="wizard#incPiece"
                      class="w-8 h-8 rounded-lg border border-border-warm text-ink-soft text-base font-bold leading-none
                             hover:border-accent hover:text-accent transition" aria-label="Ajouter">+</button>
            </div>
          </div>
        <% end %>
      </div>

      <button type="button" data-action="wizard#next" class="btn-primary wizard-cta mt-4">Continuer</button>
      <p data-wizard-target="error" class="wizard-error hidden"></p>
    </section>

    <!-- 3 · Travaux + gamme, une fois pour tout le chantier -->
    <section class="wizard-step hidden" data-wizard-target="step" data-step="travaux_gamme" data-validate="travaux_gamme">
      <div class="wizard-eyebrow">Vos travaux</div>
      <h2 class="wizard-question !mb-2">Que souhaitez-vous faire ?</h2>
      <p class="text-ink-light text-sm mb-3">Plusieurs choix possibles.</p>

      <div class="grid grid-cols-2 gap-2 max-w-lg w-full">
        <% travaux.each do |val, label| %>
          <label class="relative cursor-pointer">
            <input type="checkbox" name="piece_travaux" value="<%= val %>" class="peer sr-only"
                   data-action="change->wizard#onTravauxChange">
            <span class="block px-3 py-2.5 border-2 border-border-warm rounded-xl text-sm font-semibold text-ink-soft transition
                         peer-checked:border-accent peer-checked:bg-accent/5 peer-checked:text-ink hover:border-accent/50"><%= label %></span>
          </label>
        <% end %>
      </div>

      <div class="w-full max-w-lg mt-4 text-left">
        <label class="label-field">Niveau de finition</label>
        <div data-card-group data-auto-advance="false" class="grid grid-cols-3 gap-2">
          <input type="hidden" name="piece_gamme" value="milieu">
          <% gammes.each_with_index do |(key, label, desc), i| %>
            <button type="button" data-card data-value="<%= key %>" <%= 'data-selected=true'.html_safe if key == "milieu" %>
                    data-action="wizard#selectCard" class="wizard-card !p-3">
              <span class="wizard-card-title text-sm"><%= label.sub(" de gamme", "") %></span>
              <span class="wizard-card-sub text-[11px] leading-snug"><%= desc %></span>
            </button>
          <% end %>
        </div>
      </div>

      <button type="button" data-action="wizard#next" class="btn-primary wizard-cta mt-6">Continuer</button>
      <p data-wizard-target="error" class="wizard-error hidden"></p>
    </section>

    <!-- Écrans « dimensions » (un par pièce, générés dynamiquement) -->
    <div data-wizard-target="piecesContainer"></div>

    <!-- 4 · Précisions : tout ce qui reste, sur un seul écran -->
    <section class="wizard-step hidden" data-wizard-target="step" data-step="precisions" data-precisions>
      <div class="wizard-eyebrow">Le chantier</div>
      <h2 class="wizard-question">Quelques précisions</h2>
      <p class="text-ink-light mb-5">Elles nous aident à affiner votre devis.</p>

      <div class="w-full max-w-md space-y-4 text-left">
        <div data-prec-block="reno">
          <label class="label-field">État des surfaces</label>
          <select name="prec_etat" class="input-field">
            <option value="">Sélectionnez…</option>
            <% etats.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
          </select>
        </div>

        <div data-prec-block="peinture" class="grid grid-cols-2 gap-3">
          <div>
            <label class="label-field">Type de peinture</label>
            <select name="prec_peinture" class="input-field">
              <option value="">Sélectionnez…</option>
              <% peintures.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
            </select>
          </div>
          <div>
            <label class="label-field">Teintes</label>
            <select name="prec_teintes" class="input-field">
              <option value="">Sélectionnez…</option>
              <% teintes.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
            </select>
          </div>
        </div>

        <div data-prec-block="parquet">
          <label class="label-field">Revêtement de sol actuel</label>
          <select name="prec_sol" class="input-field">
            <option value="">Sélectionnez…</option>
            <% sols.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
          </select>
        </div>

        <%# L'étage entre dans le calcul (coefficient) : il doit rester avant l'envoi. %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :etage, "Étage", class: "label-field" %>
            <%= f.number_field :etage, value: 0, min: 0, max: 29, step: 1,
                  class: "input-field text-center", placeholder: "0" %>
            <p class="text-[11px] text-ink-light mt-1">0 = rez-de-chaussée</p>
          </div>
          <div>
            <label class="label-field">Accès</label>
            <%= f.select :ascenseur, [["Ascenseur ou RDC", "true"], ["Escaliers uniquement", "false"]],
                  {}, class: "input-field" %>
          </div>
        </div>
      </div>

      <button type="button" data-action="wizard#next" class="btn-primary wizard-cta mt-6">Continuer</button>
    </section>

    <!-- 5 · Coordonnées (gate) — le récapitulatif y est intégré -->
    <section class="wizard-step hidden" data-wizard-target="step" data-step="contact" data-validate="contact" data-no-enter>
      <div class="wizard-eyebrow">Votre devis</div>
      <h2 class="wizard-question">Votre devis chiffré est prêt</h2>

      <!-- Loader de calcul -->
      <div data-wizard-target="loader" class="w-full max-w-lg flex flex-col items-center gap-3 py-10">
        <span class="w-10 h-10 border-[3px] border-accent/30 border-t-accent rounded-full animate-spin"></span>
        <p class="text-ink-soft font-semibold">Calcul de votre devis en cours…</p>
      </div>

      <%# Ordre de grandeur affiché AVANT les coordonnées : le client doit
          pouvoir se situer sans devoir donner son numéro à l'aveugle. Le devis
          chiffré, lui, reste derrière le formulaire. %>
      <div data-wizard-target="fourchette" class="hidden w-full max-w-lg mb-4">
        <div class="px-5 py-4 bg-ink text-sand rounded-2xl text-center">
          <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-sand/60">Votre projet se situe entre</div>
          <div data-wizard-target="fourchetteMontants" class="font-display text-2xl text-accent mt-1"></div>
          <div class="text-[11px] text-sand/60 mt-1">Estimation indicative · le détail poste par poste juste en dessous</div>
        </div>
      </div>

      <!-- Récapitulatif du projet + options (ex-écran « récap ») -->
      <div data-wizard-target="recap" class="hidden w-full max-w-lg mb-4 text-left"></div>

      <!-- Devis chiffré flouté tant que les coordonnées ne sont pas saisies -->
      <%# Les montants sont déjà masqués ligne à ligne (devis-blur) : un calque
          par-dessus rendait le récapitulatif illisible sur mobile. Le message
          passe en pied de carte, où il se lit. %>
      <div data-wizard-target="devisTeaser" class="hidden w-full max-w-lg mb-6">
        <div class="bg-cream border border-border-warm rounded-2xl overflow-hidden">
          <div data-wizard-target="devisRows" class="space-y-2 p-5 text-left"></div>
          <div class="flex items-center gap-3 px-5 py-3 bg-sand border-t border-border-warm text-left">
            <span class="text-lg shrink-0">🔒</span>
            <p class="text-sm font-semibold text-ink">Complétez vos coordonnées ci-dessous pour afficher votre devis détaillé.</p>
          </div>
        </div>
      </div>

      <div class="w-full max-w-lg grid sm:grid-cols-2 gap-4 text-left">
        <div class="sm:col-span-2">
          <%= f.label :nom, "Nom complet *", class: "label-field" %>
          <%= f.text_field :nom, placeholder: "Jean Dupont", class: "input-field" %>
        </div>
        <div>
          <%= f.label :email, "Email *", class: "label-field" %>
          <%= f.email_field :email, placeholder: "jean@exemple.fr", class: "input-field" %>
        </div>
        <div>
          <%= f.label :telephone, "Téléphone *", class: "label-field" %>
          <%= f.telephone_field :telephone, placeholder: "06 12 34 56 78", class: "input-field" %>
        </div>
        <div>
          <%= f.label :code_postal, "Code postal *", class: "label-field" %>
          <%# Clavier numérique sur mobile (84 % du trafic) : cinq chiffres, pas un mot.
              ⚠️ `maxlength` vaut 7 et NON 5 : beaucoup écrivent « 33 640 ». À 5,
              le navigateur tronquait la saisie à « 33 64 », la validation
              refusait « 5 chiffres » et le visiteur restait coincé sur un champ
              qui semblait pourtant rempli. Les espaces sont retirés au moment
              de valider. %>
          <%= f.text_field :code_postal, placeholder: "33640", class: "input-field",
                inputmode: "numeric", maxlength: 7, autocomplete: "postal-code" %>
        </div>
        <div>
          <%= f.label :ville, "Ville", class: "label-field" %>
          <%= f.text_field :ville, placeholder: "Ayguemorte-les-Graves", class: "input-field" %>
        </div>
      </div>

      <%# Le reste est REPLIÉ, volontairement. Mesuré du 11 au 18/08 : 5 visiteurs
          sur l'écran contact, 4 n'ont jamais tapé le bouton — le mur de onze
          champs devant un devis flouté faisait renoncer. Quatre champs requis
          suffisent pour rappeler ; tout le reste s'obtient au téléphone. %>
      <details class="w-full max-w-lg mt-3 text-left group">
        <summary class="cursor-pointer text-sm font-semibold text-ink-soft hover:text-accent transition list-none flex items-center gap-2">
          <span class="inline-block transition-transform group-open:rotate-90">▸</span>
          Ajouter des précisions <span class="font-normal text-ink-light">(adresse, délai, photos…)</span>
        </summary>
        <div class="grid sm:grid-cols-2 gap-4 mt-4">
          <div class="sm:col-span-2">
            <%= f.label :adresse, "Adresse du chantier", class: "label-field" %>
            <%= f.text_field :adresse, placeholder: "12 rue des Lilas", class: "input-field" %>
          </div>
          <div>
            <%= f.label :delai, "Délai envisagé", class: "label-field" %>
            <%= f.select :delai, Estimation::DELAIS.map { |k, v| [v, k] }, { include_blank: "Sélectionnez…" }, class: "input-field" %>
          </div>
          <div>
            <label class="label-field">Vous êtes</label>
            <select name="prec_profil" class="input-field">
              <option value="">Sélectionnez…</option>
              <% profils.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="label-field">Comment nous avez-vous connus ?</label>
            <select name="prec_source" class="input-field">
              <option value="">Sélectionnez…</option>
              <% sources.each do |label| %><option value="<%= label %>"><%= label %></option><% end %>
            </select>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :message, "Précisions (optionnel)", class: "label-field" %>
            <%= f.text_area :message, rows: 2, placeholder: "État actuel, contraintes particulières…", class: "input-field" %>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :photos, "Photos du chantier (optionnel)", class: "label-field" %>
            <%= f.file_field :photos, multiple: true, accept: "image/*",
                  class: "block w-full text-sm text-ink-soft file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-accent file:text-white hover:file:bg-accent-dark cursor-pointer" %>
          </div>
        </div>
      </details>

      <% if @estimation.errors.any? %>
        <div class="w-full max-w-lg mt-5 p-4 bg-red-50 border border-red-200 rounded-xl text-left">
          <div class="font-semibold text-red-800 mb-1">Merci de corriger :</div>
          <ul class="list-disc list-inside text-sm text-red-700">
            <% @estimation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <p data-wizard-target="error" class="wizard-error hidden"></p>

      <button type="button" data-action="wizard#submitForm" data-wizard-target="submitBtn" class="btn-primary wizard-cta mt-6">
        Afficher mon devis chiffré
      </button>
      <p class="text-xs text-ink-light mt-4 max-w-md leading-relaxed">
        Votre devis détaillé s'affiche immédiatement et vous est envoyé par e-mail.
        Aucun démarchage : vos coordonnées ne servent qu'à ce devis et ne sont jamais cédées.
      </p>

      <%# Le téléphone AU POINT DE DÉCISION : 13 visiteurs ont atteint cet écran
          du 11 au 25/08 pour 1 seule soumission, pendant que le seul appel reçu
          (24/08) est devenu un devis signé le jour même. Le bouton de la topbar
          existe mais n'est plus visible au moment où l'on hésite devant le
          formulaire. Fail-closed : sans BUSINESS_PHONE, le bloc disparaît. %>
      <% if business_phone.present? %>
        <div class="w-full max-w-md mt-5 pt-4 border-t border-border-warm/60 text-center">
          <p class="text-sm font-semibold text-ink-soft">Vous préférez en parler de vive voix ?</p>
          <a href="<%= business_phone_link %>" class="mt-1.5 inline-flex items-center gap-2 font-display text-xl text-accent hover:underline">
            <span aria-hidden="true">📞</span> <%= business_phone %>
          </a>
          <p class="text-xs text-ink-light mt-1">Je réponds moi-même, du lundi au samedi, 8 h – 18 h.</p>
        </div>
      <% end %>
    </section>

  </main>

  <!-- Gabarit d'une pièce : un seul écran, les dimensions (le type vient de
       l'écran « quelles pièces », travaux et gamme sont communs au chantier). -->
  <template data-wizard-target="pieceTemplate">
    <section class="wizard-step hidden" data-wizard-target="step" data-piece-index="__N__"
             data-piece-type="__TYPE__" data-piece-label="__LABEL__" data-validate="dimensions">
      <div class="wizard-eyebrow">__LABEL__</div>
      <h2 class="wizard-question !mb-2">Quelle taille fait cette pièce ?</h2>
      <p class="text-ink-light text-sm mb-4 max-w-md">Sa surface au sol suffit — celle du bail ou de l'annonce.</p>

      <%# Mode simple : une seule valeur, celle que le client connaît. Demander
          le « développé des murs » était la seule question du tunnel à laquelle
          un particulier ne sait pas répondre. %>
      <div data-mode="simple" class="w-full max-w-md">
        <div class="grid grid-cols-3 gap-2 mb-4">
          <% [["Petite", "9", "≤ 12 m²"], ["Moyenne", "16", "12 – 20 m²"], ["Grande", "25", "> 20 m²"]].each do |label, valeur, sub| %>
            <button type="button" data-taille data-valeur="<%= valeur %>" data-action="wizard#choisirTaille"
                    class="px-2 py-2.5 border-2 border-border-warm rounded-xl transition
                           hover:border-accent/50 data-[selected=true]:border-accent data-[selected=true]:bg-accent/5">
              <span class="block text-sm font-semibold text-ink"><%= label %></span>
              <span class="block text-[11px] text-ink-light"><%= sub %></span>
            </button>
          <% end %>
        </div>

        <div class="p-4 bg-cream border border-border-warm rounded-xl text-left">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label-field">Surface au sol</label>
              <div class="flex items-center gap-2">
                <input type="number" data-dim="surface_sol" min="1" step="0.5" inputmode="decimal" placeholder="16"
                       data-action="input->wizard#liveSurface"
                       class="input-field text-center no-spin">
                <span class="text-ink-light text-sm">m²</span>
              </div>
            </div>
            <div data-champ="hauteur">
              <label class="label-field">Hauteur sous plafond</label>
              <div class="flex items-center gap-2">
                <input type="number" data-dim="hauteur" min="1.5" max="6" step="0.05" inputmode="decimal" value="2.5"
                       data-action="input->wizard#liveSurface"
                       class="input-field text-center no-spin">
                <span class="text-ink-light text-sm">m</span>
              </div>
            </div>
          </div>

          <%# Le calcul s'affiche pendant la frappe : la promesse « surface
              calculée automatiquement » n'était tenue nulle part. %>
          <p data-surface-live class="text-sm text-ink-soft mt-3 min-h-[1.25rem]"></p>
        </div>

        <button type="button" data-action="wizard#basculerPrecis"
                class="text-xs text-ink-light hover:text-accent underline mt-3">
          Je préfère saisir mes dimensions exactes
        </button>
      </div>

      <%# Mode précis : conservé pour ceux qui ont leurs mesures. %>
      <div data-mode="precis" class="hidden w-full max-w-md space-y-4">
        <div data-dim-group="murs" class="p-4 bg-cream border border-border-warm rounded-xl text-left">
          <div class="text-xs font-bold uppercase tracking-wide text-accent mb-3">Murs · longueur × hauteur</div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label-field">Longueur des murs</label>
              <input type="number" data-dim="murs_L" min="0.1" step="0.05" inputmode="decimal" placeholder="14"
                     data-action="input->wizard#liveSurface" class="input-field text-center no-spin">
              <p class="text-[11px] text-ink-light mt-1">Périmètre à peindre, en mètres.</p>
            </div>
            <div>
              <label class="label-field">Hauteur</label>
              <input type="number" data-dim="murs_H" min="0.1" step="0.05" inputmode="decimal" placeholder="2.5"
                     data-action="input->wizard#liveSurface" class="input-field text-center no-spin">
            </div>
          </div>
        </div>

        <div data-dim-group="sol" class="p-4 bg-cream border border-border-warm rounded-xl text-left">
          <div class="text-xs font-bold uppercase tracking-wide text-accent mb-3">Sol / plafond · longueur × largeur</div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="label-field">Longueur</label>
              <input type="number" data-dim="sol_L" min="0.1" step="0.05" inputmode="decimal" placeholder="4"
                     data-action="input->wizard#liveSurface" class="input-field text-center no-spin">
            </div>
            <div>
              <label class="label-field">Largeur</label>
              <input type="number" data-dim="sol_l" min="0.1" step="0.05" inputmode="decimal" placeholder="3"
                     data-action="input->wizard#liveSurface" class="input-field text-center no-spin">
            </div>
          </div>
        </div>

        <button type="button" data-action="wizard#basculerSimple"
                class="text-xs text-ink-light hover:text-accent underline">
          ← Revenir à la saisie simple
        </button>
      </div>

      <button type="button" data-action="wizard#next" class="btn-primary wizard-cta mt-6">Continuer</button>
      <p data-wizard-target="error" class="wizard-error hidden"></p>
    </section>
  </template>

<% end %>
