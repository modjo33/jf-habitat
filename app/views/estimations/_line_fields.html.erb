<div class="estimation-line p-5 bg-sand rounded-xl border border-ink/5" data-estimation-target="line" data-controller="line">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="w-7 h-7 bg-accent text-white rounded-lg flex items-center justify-center text-xs font-bold line-number">•</span>
      <span class="font-display font-bold text-ink text-sm">Pièce / prestation</span>
    </div>
    <%= f.hidden_field :_destroy, data: { estimation_target: "destroyFlag" } %>
    <button type="button" data-action="estimation#removeLine" class="text-xs text-red-600 hover:text-red-700 font-medium inline-flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
      Retirer
    </button>
  </div>

  <!-- Identification pièce -->
  <div class="grid md:grid-cols-12 gap-3 mb-3">
    <div class="md:col-span-5">
      <%= f.label :piece, "Nom de la pièce", class: "label-field text-xs" %>
      <%= f.text_field :piece, placeholder: "ex: Salon principal", class: "input-field text-sm py-2.5", data: { action: "input->estimation#updatePreview" } %>
    </div>
    <div class="md:col-span-4">
      <%= f.label :type_piece, "Type", class: "label-field text-xs" %>
      <%= f.select :type_piece,
                   EstimationLine::TYPES_PIECE.map { |k, v| [v[:label] + (v[:coef] > 1 ? " (+#{((v[:coef]-1)*100).to_i}%)" : ""), k] },
                   { selected: "salon" },
                   class: "input-field text-sm py-2.5", data: { action: "change->estimation#updatePreview" } %>
    </div>
    <div class="md:col-span-3">
      <%= f.label :gamme, "Gamme", class: "label-field text-xs" %>
      <%= f.select :gamme,
                   Tarif::GAMMES.map { |k, v| [v[:label], k] },
                   { selected: "milieu" },
                   class: "input-field text-sm py-2.5",
                   data: { action: "change->estimation#updatePreview" } %>
    </div>
  </div>

  <!-- Prestation -->
  <div class="mb-3">
    <div class="flex items-center justify-between">
      <%= f.label :prestation, "Prestation", class: "label-field text-xs" %>
      <%= link_to "Différences entre gammes ?", prestations_path, target: "_blank", class: "text-xs text-accent hover:underline" %>
    </div>
    <%= f.select :prestation,
                 Tarif::PRESTATIONS.map { |k, v| [v[:label], k] },
                 { include_blank: "Choisir la prestation…" },
                 class: "input-field text-sm py-2.5",
                 data: { action: "change->line#onPrestationChange change->estimation#updatePreview", line_target: "prestation" } %>
  </div>

  <!-- Toggle mode de saisie -->
  <div class="mb-3">
    <div class="inline-flex bg-white rounded-lg p-0.5 border border-ink/10 text-xs">
      <label class="cursor-pointer">
        <%= f.radio_button :mode_saisie, "surface", class: "peer sr-only", checked: true, data: { action: "change->line#toggleMode change->estimation#updatePreview", line_target: "modeRadio" } %>
        <span class="block px-3 py-1.5 rounded peer-checked:bg-accent peer-checked:text-white font-semibold">Surface (m²)</span>
      </label>
      <label class="cursor-pointer">
        <%= f.radio_button :mode_saisie, "dimensions", class: "peer sr-only", data: { action: "change->line#toggleMode change->estimation#updatePreview", line_target: "modeRadio" } %>
        <span class="block px-3 py-1.5 rounded peer-checked:bg-accent peer-checked:text-white font-semibold">Dimensions</span>
      </label>
    </div>
  </div>

  <!-- Champ surface directe -->
  <div class="mode-surface" data-line-target="modeSurface">
    <%= f.label :surface, "Surface (m²)", class: "label-field text-xs" %>
    <%= f.number_field :surface, step: 0.1, min: 0, placeholder: "24", class: "input-field text-sm py-2.5", data: { action: "input->estimation#updatePreview" } %>
  </div>

  <!-- Champs dimensions -->
  <div class="mode-dimensions hidden" data-line-target="modeDimensions">
    <p class="text-xs text-ink-light mb-2" data-line-target="dimHint">Surface calculée automatiquement.</p>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :longueur, "Longueur (m)", class: "label-field text-xs" %>
        <%= f.number_field :longueur, step: 0.01, min: 0, placeholder: "5.5", class: "input-field text-sm py-2.5", data: { action: "input->estimation#updatePreview" } %>
      </div>
      <%# Largeur : uniquement pour sols/plafonds (surface = L × l) %>
      <div data-line-target="largeurWrap">
        <%= f.label :largeur, "Largeur (m)", class: "label-field text-xs" %>
        <%= f.number_field :largeur, step: 0.01, min: 0, placeholder: "4.2", class: "input-field text-sm py-2.5", data: { action: "input->estimation#updatePreview" } %>
      </div>
      <%# Hauteur : uniquement pour les murs (surface = longueur de mur × hauteur) %>
      <div class="hidden" data-line-target="hauteurWrap">
        <%= f.label :hauteur, "Hauteur (m)", class: "label-field text-xs" %>
        <%= f.number_field :hauteur, step: 0.01, min: 0, placeholder: "2.5", class: "input-field text-sm py-2.5", data: { action: "input->estimation#updatePreview" } %>
      </div>
    </div>
  </div>
</div>
