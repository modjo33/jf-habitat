<%# Projet laissé sur l'estimateur au moment où le visiteur a donné son numéro.
    Le button_to est HORS de tout form_with (la liste des notes n'en a pas). %>
<% m2 = ->(v) { v.to_f.positive? ? "#{number_with_precision(v, precision: 2, strip_insignificant_zeros: true, separator: ',')} m²" : nil } %>
<div class="mt-3 rounded-lg border border-border-warm/60 bg-sand/60 p-4 text-sm">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div class="text-[11px] font-bold uppercase tracking-[0.15em] text-accent">Projet saisi sur l'estimateur</div>
    <div class="text-xs text-ink-light">
      <%= [ projet.chantier_label, projet.gamme_label,
            (projet.code_postal && "CP #{projet.code_postal}"),
            (projet.etage && projet.etage != "0" && "#{projet.etage}e étage") ].compact.join(" · ") %>
    </div>
  </div>

  <% if projet.pieces.any? %>
    <table class="w-full text-xs mb-3">
      <thead>
        <tr class="text-left text-[10px] uppercase tracking-widest text-ink-light">
          <th class="py-1 pr-2 font-semibold">Pièce</th><th class="py-1 pr-2 font-semibold">Travaux</th><th class="py-1 font-semibold">Dimensions</th>
        </tr>
      </thead>
      <tbody>
        <% projet.pieces.each do |p| %>
          <tr class="border-t border-border-warm/50 align-top">
            <td class="py-1.5 pr-2 font-semibold text-ink"><%= p["label"] %></td>
            <td class="py-1.5 pr-2 text-ink-soft"><%= Array(p["travaux"]).join(", ") %></td>
            <td class="py-1.5 text-ink-soft">
              <%= [ (p["mode"] == "precis" ? "mesures précises" : (m2.(p["surface_sol"]) && "sol #{m2.(p["surface_sol"])}")),
                    (p["mode"] != "precis" && p["hauteur"].to_f.positive? && "HSP #{number_with_precision(p["hauteur"], precision: 2, strip_insignificant_zeros: true, separator: ',')} m"),
                    (m2.(p["murs"]) && "murs #{m2.(p["murs"])}"),
                    (p["mode"] == "precis" && m2.(p["sol"]) && "sol #{m2.(p["sol"])}"),
                    (m2.(p["cloison"]) && p["cloison"] != p["murs"] && "cloison #{m2.(p["cloison"])}") ].select(&:present?).join(" · ") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if projet.precisions.any? || projet.options.any? %>
    <ul class="text-xs text-ink-soft space-y-0.5 mb-3">
      <% projet.precisions.each do |libelle, valeur| %><li><span class="text-ink-light"><%= libelle %> :</span> <%= valeur %></li><% end %>
      <% if projet.options.any? %><li><span class="text-ink-light">Options :</span> <%= projet.options.join(", ") %></li><% end %>
    </ul>
  <% end %>

  <% if (c = projet.chiffrage) %>
    <div class="border-t border-border-warm/60 pt-2 mb-3">
      <% Array(c["lignes"]).each do |l| %>
        <div class="flex justify-between gap-3 text-xs text-ink-soft">
          <span><%= l["libelle"] %><% if l["surface"].to_f.positive? %> <span class="text-ink-light">(<%= m2.(l["surface"]) %>)</span><% end %></span>
          <span class="whitespace-nowrap"><%= eur(l["total"]) %></span>
        </div>
      <% end %>
      <div class="flex justify-between gap-3 pt-1 mt-1 border-t border-border-warm/40 font-semibold text-ink">
        <span>Prix affiché au visiteur</span><span class="whitespace-nowrap"><%= eur(c["total_ttc"]) %></span>
      </div>
    </div>
  <% end %>

  <% if (e = projet.estimation) %>
    <%= link_to "Voir l'estimation #{e.reference} →", admin_estimation_path(e), class: "text-xs font-semibold text-accent hover:underline" %>
  <% elsif projet.lignes.any? %>
    <%= button_to "Créer l'estimation à partir de ce projet", estimation_admin_client_note_path(client, note),
          class: "text-xs font-semibold bg-accent text-white px-3 py-1.5 rounded-full hover:bg-accent-dark" %>
  <% end %>
</div>
