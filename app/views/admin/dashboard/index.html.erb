<div class="mb-10">
  <div class="eyebrow mb-2">Aperçu</div>
  <h1 class="h-display text-4xl text-ink">Dashboard</h1>
  <p class="text-ink-light mt-2">Vue d'ensemble de votre activité.</p>
</div>

<div class="grid md:grid-cols-4 gap-4 mb-10">
  <% [
    { label: "Total leads",    value: @total_leads,   accent: false },
    { label: "Cette semaine",  value: @leads_semaine, accent: true },
    { label: "Ce mois",        value: @leads_mois,    accent: false },
    { label: "CA potentiel",   value: number_to_currency(@ca_potentiel, unit: "€", separator: ",", delimiter: " ", format: "%n %u"), accent: false }
  ].each do |stat| %>
    <div class="card-premium p-6 <%= 'bg-ink text-sand border-ink' if stat[:accent] %>">
      <div class="text-[11px] font-bold uppercase tracking-[0.18em] <%= stat[:accent] ? 'text-accent' : 'text-ink-light' %>">
        <%= stat[:label] %>
      </div>
      <div class="font-display text-3xl mt-2 <%= stat[:accent] ? 'text-sand' : 'text-ink' %>">
        <%= stat[:value] %>
      </div>
    </div>
  <% end %>
</div>

<!-- Agenda du jour -->
<div class="card-premium p-6 mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-display text-xl text-ink">Agenda — aujourd'hui</h2>
    <%= link_to "Voir l'agenda →", admin_rdvs_path, class: "text-sm text-accent hover:underline" %>
  </div>
  <% if @rdvs_jour.empty? %>
    <p class="text-sm text-ink-light">Aucun RDV aujourd'hui.</p>
  <% else %>
    <div class="space-y-1.5">
      <% @rdvs_jour.each do |rdv| %>
        <%= link_to edit_admin_rdv_path(rdv), class: "flex items-center gap-3 p-2 rounded-lg hover:bg-sand" do %>
          <span class="w-1.5 h-8 rounded-full shrink-0" style="background:<%= rdv.couleur %>"></span>
          <span class="text-sm font-semibold text-ink w-28 shrink-0"><%= rdv.horaire %></span>
          <span class="text-sm text-ink truncate flex-1"><%= rdv.titre %><% if rdv.client %> · <span class="text-ink-light"><%= rdv.client.nom %></span><% end %></span>
          <% if rdv.adresse.present? %><span class="text-xs text-ink-light truncate hidden lg:block max-w-[200px]"><%= rdv.adresse %></span><% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @rdvs_a_venir.any? %>
    <div class="mt-4 pt-4 border-t border-border-warm/60 flex flex-wrap items-center gap-2">
      <span class="text-[10px] uppercase tracking-wider text-ink-light font-bold">À venir</span>
      <% @rdvs_a_venir.each do |rdv| %>
        <%= link_to edit_admin_rdv_path(rdv), class: "text-xs px-3 py-1.5 rounded-full border border-border-warm hover:bg-sand text-ink" do %>
          <span style="color:<%= rdv.couleur %>">●</span> <%= rdv.starts_at.strftime("%d/%m") %> · <%= rdv.titre.truncate(24) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="grid md:grid-cols-3 gap-4 mb-10">
  <div class="card-premium p-6 flex items-center justify-between <%= 'border-accent' if @prochaine_declaration.a_declarer? %>">
    <div>
      <div class="text-[11px] font-bold uppercase tracking-[0.18em] <%= @prochaine_declaration.a_declarer? ? 'text-accent' : 'text-ink-light' %>">
        URSSAF · <%= @prochaine_declaration.libelle %>
      </div>
      <div class="font-display text-3xl mt-2 text-ink">
        <%= number_to_currency(@prochaine_declaration.ca, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      </div>
      <div class="text-xs text-ink-light mt-1">
        <%= @prochaine_declaration.a_declarer? ? "à déclarer" : "trimestre en cours" %> · limite <%= l @prochaine_declaration.date_limite, format: "%d/%m" %>
      </div>
    </div>
    <%= link_to "Voir →", admin_declarations_path, class: "text-sm text-accent font-semibold hover:underline shrink-0" %>
  </div>
  <div class="card-premium p-6 flex items-center justify-between">
    <div>
      <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light">Devis acceptés</div>
      <div class="font-display text-3xl mt-2 text-ink"><%= @nb_devis_acceptes %></div>
      <div class="text-xs text-ink-light mt-1">clients passés en « Gagné »</div>
    </div>
    <%= link_to "Voir →", admin_clients_path(statut: "gagne"), class: "text-sm text-accent font-semibold hover:underline shrink-0" %>
  </div>
  <div class="card-premium p-6 bg-ink text-sand border-ink">
    <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent">CA gagné</div>
    <div class="font-display text-3xl mt-2 text-sand"><%= number_to_currency(@ca_gagne, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></div>
    <div class="text-xs text-sand/60 mt-1">devis acceptés (estimateur + manuels)</div>
  </div>
</div>

<% niveau = @campagne.niveau %>
<% bar = niveau == :critique ? "bg-red-500" : (niveau == :surveiller ? "bg-accent" : "bg-ink") %>
<div class="card-premium p-7 mb-10">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
    <div>
      <h2 class="font-display text-2xl text-ink">Campagne Google Ads</h2>
      <p class="text-xs text-ink-light mt-1">
        <%= @campagne.nom %> · financée par Switchloop
        <% if @campagne.depense_maj_le %> · dépense mise à jour le <%= l @campagne.depense_maj_le, format: "%d/%m" %><% end %>
      </p>
    </div>
    <div class="text-right">
      <div class="text-[11px] font-bold uppercase tracking-[0.18em] <%= niveau == :critique ? 'text-red-600' : 'text-ink-light' %>">
        <%= niveau == :critique ? "⚠️ Stop bientôt" : (niveau == :surveiller ? "À surveiller" : "Ça tourne") %>
      </div>
      <div class="font-display text-3xl text-ink"><%= @campagne.pourcentage %> %</div>
      <div class="text-xs text-ink-light">du budget consommé</div>
    </div>
  </div>

  <div class="h-3 rounded-full bg-sand overflow-hidden border border-border-warm/60 mb-2">
    <div class="h-full rounded-full <%= bar %>" style="width: <%= @campagne.pourcentage %>%"></div>
  </div>
  <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-ink-light mb-6">
    <span>Dépensé : <strong class="text-ink"><%= number_to_currency(@campagne.depense_cumulee, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></strong></span>
    <span>Budget : <strong class="text-ink"><%= number_to_currency(@campagne.budget_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></strong></span>
    <span>Reste : <strong class="text-ink"><%= number_to_currency(@campagne.budget_restant, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></strong> (≈ <%= @campagne.jours_budget_restant %> j)</span>
    <% if @campagne.jours_avant_validation %>
      <span>Validation annonceur : <strong class="<%= @campagne.jours_avant_validation <= 10 ? 'text-red-600' : 'text-ink' %>">dans <%= @campagne.jours_avant_validation %> j</strong> (Kbis Switchloop)</span>
    <% end %>
  </div>

  <%= form_with model: @campagne, url: admin_campagne_ads_path, method: :patch, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :depense_cumulee, "Dépense cumulée (€)", class: "block text-[11px] font-bold uppercase tracking-[0.15em] text-ink-light mb-1" %>
      <%= f.text_field :depense_cumulee, value: number_with_precision(@campagne.depense_cumulee, precision: 2, separator: ","),
            class: "input-field w-40", placeholder: "ex : 120,50" %>
    </div>
    <div>
      <%= f.label :budget_total, "Budget max (€)", class: "block text-[11px] font-bold uppercase tracking-[0.15em] text-ink-light mb-1" %>
      <%= f.text_field :budget_total, value: number_with_precision(@campagne.budget_total, precision: 2, separator: ","),
            class: "input-field w-32" %>
    </div>
    <%= f.submit "Mettre à jour", class: "bg-ink text-sand text-sm font-bold px-5 py-2.5 rounded-lg hover:opacity-90 transition cursor-pointer" %>
    <span class="text-[11px] text-ink-light">Relève la dépense dans Google Ads → Facturation → Récapitulatif, puis reporte-la ici.</span>
  <% end %>
</div>

<div class="card-premium p-7">
  <div class="flex items-center justify-between mb-6">
    <h2 class="font-display text-2xl text-ink">Derniers leads</h2>
    <%= link_to "Voir tous →", admin_estimations_path, class: "text-sm text-accent font-semibold hover:underline" %>
  </div>

  <% if @derniers_leads.empty? %>
    <div class="text-center py-12 text-ink-light">Aucun lead pour le moment.</div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-[11px] uppercase tracking-[0.15em] text-ink-light border-b border-border-warm/60">
            <th class="py-3 font-semibold">Réf</th>
            <th class="py-3 font-semibold">Client</th>
            <th class="py-3 font-semibold">Téléphone</th>
            <th class="py-3 font-semibold">Total TTC</th>
            <th class="py-3 font-semibold">Statut</th>
            <th class="py-3 font-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          <% @derniers_leads.each do |lead| %>
            <tr class="border-b border-border-warm/40 hover:bg-sand transition">
              <td class="py-3">
                <%= link_to lead.reference, admin_estimation_path(lead), class: "font-mono text-xs text-accent font-semibold hover:underline" %>
              </td>
              <td class="py-3">
                <div class="font-semibold text-ink"><%= lead.nom %></div>
                <div class="text-xs text-ink-light"><%= lead.email %></div>
              </td>
              <td class="py-3 text-ink-soft"><%= lead.telephone %></td>
              <td class="py-3 font-semibold text-ink"><%= number_to_currency(lead.ca_montant, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></td>
              <td class="py-3">
                <%= render "admin/estimations/statut_badge", statut: lead.statut %>
              </td>
              <td class="py-3 text-xs text-ink-light"><%= lead.created_at.strftime("%d/%m %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
