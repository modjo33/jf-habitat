<%= tag.div id: dom_id(ligne), data: { sortable_item: ligne.id }, class: "border border-border-warm rounded-xl bg-cream p-3" do %>
  <%= form_with model: [:admin, ligne], data: { controller: "autosave" } do |f| %>
    <div class="flex flex-wrap items-start gap-2">
      <button type="button" data-action="pointerdown->sortable#start"
              class="shrink-0 pt-2 px-0.5 text-ink-light/40 hover:text-accent cursor-grab active:cursor-grabbing touch-none leading-none select-none"
              aria-label="Réordonner la ligne" title="Glisser pour réordonner">⠿</button>
      <div class="flex-1 min-w-[12rem]">
        <%= f.text_field :libelle, placeholder: "Libellé de la prestation",
              class: "input-field !py-1.5 font-medium",
              data: { action: "change->autosave#save" } %>
      </div>

      <div class="w-16">
        <%= f.number_field :quantite,
              value: (ligne.forfait? ? nil : vide_si_zero(ligne.quantite)),
              disabled: ligne.forfait?, step: "0.001", inputmode: "decimal",
              placeholder: "qté", class: "input-field !py-1.5 text-center",
              data: { "autosave-target": "qte",
                      action: "focus->autosave#select input->autosave#liveLigne change->autosave#save" } %>
      </div>

      <div class="w-28">
        <%= f.select :unite, DevisLigne::UNITES.map { |k, v| [v, k] }, {},
              class: "input-field !py-1.5",
              data: { "autosave-target": "unite",
                      action: "change->autosave#liveLigne change->autosave#save" } %>
      </div>

      <div class="w-24">
        <%= f.number_field :prix_unitaire, value: vide_si_zero(ligne.prix_unitaire),
              step: "0.01", inputmode: "decimal", placeholder: "€",
              class: "input-field !py-1.5 text-right",
              data: { "autosave-target": "pu",
                      action: "focus->autosave#select input->autosave#liveLigne change->autosave#save" } %>
      </div>

      <div class="w-24 pt-2 text-right font-semibold text-ink" data-autosave-target="lineTotal"><%= eur(ligne.total) %></div>

      <%= link_to "✕", admin_devis_ligne_path(ligne),
            data: { turbo_method: :delete, turbo_confirm: "Supprimer cette ligne ?" },
            class: "pt-2 px-1 text-ink-light hover:text-red-600 no-underline" %>
    </div>

    <%= f.text_area :description, rows: 2,
          placeholder: "Description affichée sur le devis (facultatif)…",
          class: "input-field !py-1.5 text-sm mt-2 w-full",
          data: { action: "change->autosave#save" } %>
  <% end %>
<% end %>
