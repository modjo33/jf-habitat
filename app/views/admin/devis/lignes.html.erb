<div class="mb-6">
  <%= link_to admin_estimation_path(@estimation), class: "inline-flex items-center gap-2 text-sm text-ink-light hover:text-ink mb-3" do %>
    ← Retour au lead
  <% end %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="h-display text-3xl text-ink">Devis détaillé — <%= @estimation.nom %></h1>
      <div class="mt-1 flex items-center gap-3 text-sm text-ink-light">
        <span class="font-mono text-xs text-accent font-semibold"><%= @estimation.reference %></span>
        <% if @estimation.adresse.present? %>
          <span><%= @estimation.adresse %> · <%= @estimation.code_postal %> <%= @estimation.ville %></span>
        <% end %>
      </div>
    </div>
    <%= link_to "Comparatif des gammes ↗", admin_gammes_path, target: "_blank",
          class: "shrink-0 text-xs font-semibold px-4 py-2 rounded-full border border-border-warm hover:bg-ink hover:text-sand transition" %>
  </div>
</div>

<%= render "admin/devis/lignes_liste", estimation: @estimation %>

<%= render "admin/devis/bar", estimation: @estimation %>
