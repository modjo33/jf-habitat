<%# Partie recalculée : remplacée en Turbo Stream à chaque saisie. %>
<% r = analyse.resultats %>
<% couleurs = { rouge: "bg-red-50 border-red-200 text-red-800",
                orange: "bg-amber-50 border-amber-200 text-amber-800" } %>

<div id="analyse_resultats" class="mt-4 pt-4 border-t border-border-warm/60">
  <% if r.montant_devis.zero? %>
    <p class="text-sm text-ink-light">Chiffre le devis pour voir sa rentabilité.</p>
  <% else %>

    <%# Alertes d'abord : c'est ce qui doit sauter aux yeux. %>
    <% if r.alertes.any? %>
      <div class="space-y-1.5 mb-4">
        <% r.alertes.each do |a| %>
          <div class="flex items-start gap-2 px-3 py-2 rounded-lg border text-xs font-semibold <%= couleurs[a[:niveau]] %>">
            <span><%= a[:niveau] == :rouge ? "🔴" : "🟠" %></span>
            <span><%= a[:message] %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center gap-2 px-3 py-2 mb-4 rounded-lg border border-green-200 bg-green-50 text-green-800 text-xs font-semibold">
        <span>✅</span><span>Chantier rentable au regard de tes objectifs.</span>
      </div>
    <% end %>

    <div class="grid sm:grid-cols-2 gap-x-8 gap-y-1.5 text-sm">
      <div class="flex justify-between gap-3">
        <span class="text-ink-light">Montant du devis</span>
        <span class="font-semibold text-ink whitespace-nowrap"><%= eur(r.montant_devis) %></span>
      </div>
      <div class="flex justify-between gap-3">
        <span class="text-ink-light">Coût du chantier</span>
        <span class="text-ink whitespace-nowrap">− <%= eur(r.cout_total) %></span>
      </div>
      <div class="flex justify-between gap-3">
        <span class="text-ink-light">Cotisations (<%= number_with_precision(r.taux_cotisations_global, precision: 2, separator: ",") %> %)</span>
        <span class="text-ink whitespace-nowrap">− <%= eur(r.cotisations) %></span>
      </div>
      <% if r.provision_impot.positive? %>
        <div class="flex justify-between gap-3">
          <span class="text-ink-light">Provision d'impôt</span>
          <span class="text-ink whitespace-nowrap">− <%= eur(r.provision_impot) %></span>
        </div>
      <% end %>
    </div>

    <%# Bénéfice net : le chiffre qui compte, mis en avant. %>
    <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3 px-4 py-3 rounded-xl
                <%= r.benefice_net.negative? ? 'bg-red-50 border border-red-200' : 'bg-sand border border-border-warm' %>">
      <span class="text-[11px] font-bold uppercase tracking-[0.15em] text-ink-light">Ce qu'il te reste</span>
      <span class="font-display text-2xl <%= r.benefice_net.negative? ? 'text-red-700' : 'text-ink' %>">
        <%= eur(r.benefice_net) %>
      </span>
      <% if r.marge_pct %>
        <span class="text-xs text-ink-light">soit <%= number_with_precision(r.marge_pct, precision: 1, separator: ",") %> % du devis</span>
      <% end %>
    </div>

    <div class="grid sm:grid-cols-3 gap-3 mt-3 text-center">
      <div class="p-2.5 bg-cream rounded-lg border border-border-warm/60">
        <div class="text-[10px] uppercase tracking-wider text-ink-light font-bold">Par heure</div>
        <div class="font-display text-lg <%= r.revenu_horaire && r.revenu_horaire < r.objectif_horaire ? 'text-accent' : 'text-ink' %>">
          <%= r.revenu_horaire ? eur(r.revenu_horaire) : "—" %>
        </div>
        <div class="text-[10px] text-ink-light">objectif <%= eur(r.objectif_horaire) %></div>
      </div>
      <div class="p-2.5 bg-cream rounded-lg border border-border-warm/60">
        <div class="text-[10px] uppercase tracking-wider text-ink-light font-bold">Par jour</div>
        <div class="font-display text-lg text-ink"><%= r.revenu_journalier ? eur(r.revenu_journalier) : "—" %></div>
        <div class="text-[10px] text-ink-light"><%= number_with_precision(r.jours, precision: 1, separator: ",") %> j de chantier</div>
      </div>
      <div class="p-2.5 bg-cream rounded-lg border border-border-warm/60">
        <div class="text-[10px] uppercase tracking-wider text-ink-light font-bold">Part matériaux</div>
        <div class="font-display text-lg text-ink"><%= r.part_materiaux_pct ? "#{number_with_precision(r.part_materiaux_pct, precision: 1, separator: ',')} %" : "—" %></div>
        <div class="text-[10px] text-ink-light">seuil <%= number_with_precision(analyse.part_materiaux_max_pct, precision: 0) %> %</div>
      </div>
    </div>

    <%# Prix plancher / conseillé : la reco actionnable. %>
    <% if r.prix_plancher %>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 px-4 py-3 rounded-xl bg-ink text-sand">
        <div>
          <div class="text-[10px] uppercase tracking-wider text-sand/60 font-bold">Prix plancher</div>
          <div class="font-display text-xl"><%= eur(r.prix_plancher) %></div>
          <div class="text-[10px] text-sand/60">pour tenir <%= eur(r.objectif_horaire) %>/h net</div>
        </div>
        <div class="text-right">
          <div class="text-[10px] uppercase tracking-wider text-accent font-bold">Conseillé</div>
          <div class="font-display text-xl text-accent"><%= eur(r.prix_conseille) %></div>
          <div class="text-[10px] text-sand/60">+ <%= number_with_precision(analyse.marge_securite_pct, precision: 0) %> % de sécurité</div>
        </div>
      </div>
    <% end %>

    <%# Écart barème / réel : ce qui permettra de recaler le barème. %>
    <% if r.depenses_reelles && r.ecart_materiaux %>
      <div class="mt-3 text-xs text-ink-light">
        Matériaux — barème <%= eur(r.cout_materiaux_estime) %> · réel <strong class="text-ink"><%= eur(r.cout_materiaux_reel) %></strong> ·
        écart <span class="<%= r.ecart_materiaux.positive? ? 'text-accent font-semibold' : 'text-green-700 font-semibold' %>"><%= r.ecart_materiaux.positive? ? "+" : "" %><%= eur(r.ecart_materiaux) %></span>
      </div>
    <% end %>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-[10px] text-ink-light">
      <span>
        Taux figés le <%= l analyse.taux_figes_at, format: "%d/%m/%Y" %> :
        <%= number_with_precision(r.taux_cotisations_global, precision: 2, separator: ",") %> % de cotisations<%= ", #{number_with_precision(r.taux_impot, precision: 2, separator: ',')} % d'impôt" if r.taux_impot.positive? %>.
      </span>
      <%= button_to "Recalculer aux taux du jour", admin_devis_analyse_refiger_path(estimation),
            method: :post, form: { data: { turbo_confirm: "Rejouer ce devis avec les taux actuels ?" } },
            class: "text-[10px] font-semibold text-ink-light hover:text-accent underline" %>
    </div>
  <% end %>
</div>
