<div id="devis_total_bar" class="sticky bottom-0 z-20 -mx-8 px-8 py-3.5 bg-ink text-sand border-t border-sand/10 shadow-premium">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-5">
      <details class="relative">
        <summary class="cursor-pointer text-sand/50 hover:text-sand text-xs list-none select-none">⚙︎ Remise</summary>
        <div class="absolute bottom-full mb-3 left-0 bg-cream text-ink rounded-xl shadow-premium p-4 w-72 border border-border-warm">
          <%= form_with url: devis_remise_admin_estimation_path(estimation), method: :patch do %>
            <div class="flex gap-2 mb-2">
              <%= select_tag "estimation[devis_remise_type]",
                    options_for_select([["Aucune", "aucune"], ["Pourcentage %", "pourcentage"], ["Montant €", "montant"]],
                      estimation.devis_remise_type.presence || "aucune"),
                    class: "input-field !py-2 text-sm flex-1" %>
              <%= number_field_tag "estimation[devis_remise_valeur]",
                    (estimation.devis_remise_valeur.to_d.zero? ? nil : estimation.devis_remise_valeur),
                    step: "0.01", inputmode: "decimal", placeholder: "0",
                    class: "input-field !py-2 text-sm w-24 text-center" %>
            </div>
            <%= submit_tag "Appliquer", class: "btn-secondary !py-2 !px-4 text-xs w-full" %>
          <% end %>
        </div>
      </details>
      <% if estimation.devis_remise_montant.to_d > 0 || estimation.devis_extras_total.to_d > 0 %>
        <div class="text-xs text-sand/60 flex flex-wrap gap-x-3 gap-y-0.5">
          <span>Travaux <%= eur(estimation.devis_total_brut) %></span>
          <% if estimation.devis_trajet_total.to_d > 0 %>
            <span>trajet + <%= eur(estimation.devis_trajet_total) %></span>
          <% end %>
          <% if estimation.devis_consommables.to_d > 0 %>
            <span>consommables + <%= eur(estimation.devis_consommables) %></span>
          <% end %>
          <% if estimation.devis_remise_montant.to_d > 0 %>
            <span class="text-accent">remise − <%= eur(estimation.devis_remise_montant) %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center gap-5">
      <div class="flex items-baseline gap-3">
        <span class="text-[11px] uppercase tracking-wider text-sand/50">Total devis</span>
        <span class="font-display text-3xl text-accent"><%= eur(estimation.devis_total) %></span>
        <span class="text-[10px] text-sand/40 ml-1">TVA non applicable · art. 293 B CGI</span>
      </div>
      <% if estimation.devis_lignes.exists? %>
        <%= link_to "Générer le PDF →", devis_document_generer_admin_estimation_path(estimation),
              data: { turbo_method: :post, turbo_confirm: "Générer le PDF du devis à partir des lignes ?" },
              class: "shrink-0 bg-accent text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-accent-dark transition" %>
      <% else %>
        <%= link_to (estimation.devis_signe? ? "Devis signé ✓" : "Conclure →"),
              devis_presentation_admin_estimation_path(estimation),
              class: "shrink-0 bg-accent text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-accent-dark transition" %>
      <% end %>
    </div>
  </div>
</div>
