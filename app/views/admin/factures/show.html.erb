<% montant = ->(v) { number_to_currency(v, unit: "€", separator: ",", delimiter: " ", format: "%n %u") } %>

<div class="mb-8">
  <%= link_to "← Toutes les factures", admin_factures_path, class: "text-sm text-ink-light hover:text-accent" %>
</div>

<div class="flex items-start justify-between mb-8">
  <div>
    <div class="eyebrow mb-2">Facture</div>
    <h1 class="h-display text-4xl text-ink"><%= @facture.numero %></h1>
    <p class="text-ink-light mt-2">
      Émise le <%= l @facture.date_emission, format: "%d/%m/%Y" %> ·
      <%= link_to @facture.client.nom, admin_client_path(@facture.client), class: "text-accent hover:underline" %>
      <% if @facture.estimation %>
        · devis <%= link_to @facture.estimation.reference, admin_estimation_path(@facture.estimation), class: "text-accent hover:underline" %>
      <% end %>
    </p>
    <div class="mt-3"><%= render "admin/factures/badge_etat", facture: @facture %></div>
  </div>
  <div class="flex gap-3 shrink-0">
    <%= link_to "👁 Aperçu PDF", pdf_admin_facture_path(@facture), target: "_blank", rel: "noopener",
          class: "text-sm font-semibold border border-border-warm text-ink px-4 py-2.5 rounded-lg hover:bg-sand transition" %>
    <%= link_to "⬇ Télécharger", pdf_admin_facture_path(@facture, download: 1),
          class: "text-sm font-semibold border border-border-warm text-ink px-4 py-2.5 rounded-lg hover:bg-sand transition" %>
    <%= link_to "Modifier", edit_admin_facture_path(@facture),
          class: "text-sm font-bold bg-accent text-sand px-4 py-2.5 rounded-lg hover:opacity-90 transition" %>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="card-premium p-7">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light mb-5">Détail des prestations</h2>
      <% @facture.facture_lignes.ordered.group_by { |l| l.section.presence }.each do |section, lignes| %>
        <% if section.present? %>
          <div class="text-[11px] font-bold uppercase tracking-[0.15em] text-ink-soft mt-5 mb-2"><%= section %></div>
        <% end %>
        <table class="w-full text-sm">
          <tbody>
            <% lignes.each do |l| %>
              <tr class="border-b border-border-warm/40">
                <td class="py-3">
                  <div class="font-semibold text-ink"><%= l.libelle %></div>
                  <% if l.description.present? %>
                    <div class="text-xs text-ink-light mt-0.5"><%= l.description %></div>
                  <% end %>
                </td>
                <td class="py-3 text-center text-ink-soft whitespace-nowrap w-28">
                  <%= l.forfait? ? "forfait" : "#{number_with_precision(l.quantite, precision: 2, separator: ',')} #{l.unite_label}" %>
                </td>
                <td class="py-3 text-right text-ink-soft whitespace-nowrap w-24">
                  <%= l.forfait? ? "—" : montant.(l.prix_unitaire) %>
                </td>
                <td class="py-3 text-right font-semibold text-ink whitespace-nowrap w-28"><%= montant.(l.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>

    <% if @facture.conditions.present? %>
      <div class="card-premium p-7">
        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light mb-3">Conditions</h2>
        <p class="text-sm text-ink-soft whitespace-pre-line"><%= @facture.conditions %></p>
      </div>
    <% end %>
  </div>

  <div class="space-y-6">
    <div class="card-premium p-7">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light mb-5">Règlement</h2>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-ink-light">Total facturé</span>
          <span class="font-semibold text-ink"><%= montant.(@facture.total) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-ink-light">Encaissé</span>
          <span class="font-semibold text-green-700"><%= montant.(@facture.montant_encaisse) %></span>
        </div>
        <div class="flex justify-between pt-3 border-t border-border-warm">
          <span class="font-bold text-ink">Reste dû</span>
          <span class="font-display text-xl <%= @facture.solde.positive? ? 'text-accent' : 'text-green-700' %>">
            <%= montant.(@facture.solde) %>
          </span>
        </div>
        <p class="text-xs text-ink-light pt-2">TVA non applicable, art. 293 B du CGI.</p>
      </div>

      <% if @facture.solde.positive? %>
        <%= link_to "💰 Enregistrer un règlement",
              new_admin_encaissement_path(client_id: @facture.client_id, facture_id: @facture.id,
                                          montant: @facture.solde),
              class: "block text-center text-sm font-bold bg-accent text-sand px-4 py-2.5 rounded-lg hover:opacity-90 transition mt-5" %>
      <% end %>
    </div>

    <div class="card-premium p-7">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light mb-4">Règlements reçus</h2>
      <% if @facture.encaissements.empty? %>
        <p class="text-sm text-ink-light">Aucun règlement enregistré.</p>
      <% else %>
        <ul class="space-y-3 text-sm">
          <% @facture.encaissements.chronologique.each do |e| %>
            <li class="flex justify-between items-start">
              <div>
                <div class="text-ink-soft"><%= l e.date_encaissement, format: "%d/%m/%Y" %></div>
                <div class="text-xs text-ink-light"><%= e.mode_reglement_label %></div>
              </div>
              <span class="font-semibold text-green-700 whitespace-nowrap"><%= montant.(e.montant) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="card-premium p-7">
      <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-ink-light mb-4">Actions</h2>
      <div class="space-y-2">
        <%= button_to "↻ Régénérer le PDF", regenerer_admin_facture_path(@facture),
              class: "w-full text-sm font-semibold border border-border-warm text-ink px-4 py-2.5 rounded-lg hover:bg-sand transition" %>
        <%= button_to "Supprimer la facture", admin_facture_path(@facture), method: :delete,
              form: { data: { turbo_confirm: "Supprimer définitivement la facture #{@facture.numero} ?" } },
              class: "w-full text-sm font-semibold text-red-700 border border-red-200 px-4 py-2.5 rounded-lg hover:bg-red-50 transition" %>
      </div>
      <p class="text-xs text-ink-light mt-3">
        PDF généré le
        <%= @facture.pdf_genere_at ? l(@facture.pdf_genere_at, format: "%d/%m/%Y à %H:%M") : "—" %>.
      </p>
    </div>
  </div>
</div>
