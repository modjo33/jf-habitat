<% montant = ->(v) { number_to_currency(v, unit: "€", separator: ",", delimiter: " ", format: "%n %u") } %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Retour à la facture", admin_facture_path(@facture), class: "text-sm text-ink-light hover:text-ink" %>
    <h1 class="h-display text-3xl text-ink mt-2">Envoyer la facture</h1>
    <p class="text-ink-light mt-1">
      À <strong><%= @facture.client.nom.to_s.strip %></strong>
      <%= @facture.client.email.presence || "— pas d'adresse e-mail" %>
    </p>
  </div>

  <% if @facture.client.email.blank? %>
    <div class="card-premium p-6 border-l-4 border-accent">
      <p class="text-sm text-ink">
        Ce client n'a pas d'adresse e-mail enregistrée.
        <%= link_to "Compléter sa fiche →", admin_client_path(@facture.client), class: "text-accent font-semibold hover:underline" %>
      </p>
    </div>
  <% else %>
    <div class="card-premium p-6">
      <div class="mb-4 flex items-center justify-between p-3 bg-sand rounded-lg">
        <span class="text-sm text-ink">
          📎 <%= @facture.numero %>.pdf ·
          <% if @facture.solde.positive? && @facture.montant_encaisse.positive? %>
            solde <%= montant.(@facture.solde) %> sur <%= montant.(@facture.total) %>
          <% else %>
            <%= montant.(@facture.total) %>
          <% end %>
        </span>
        <%= link_to "Aperçu", pdf_admin_facture_path(@facture), target: "_blank", rel: "noopener",
              class: "text-xs font-semibold text-accent hover:underline" %>
      </div>

      <%= form_with url: envoyer_admin_facture_path(@facture), method: :post do %>
        <label class="label-field">Message (modifiable)</label>
        <%= text_area_tag :message, @facture.message_remerciement, rows: 14,
              class: "input-field", style: "line-height:1.5;" %>
        <p class="text-xs text-ink-light mt-1">
          Message de remerciement pré-rempli, adapté à l'état de la facture. Le PDF est joint
          automatiquement et tu reçois une copie.
        </p>
        <% if Facture.lien_avis_google %>
          <p class="text-xs text-ink-light mt-2 pl-3 border-l-2 border-accent/40">
            ⭐ Un encart « Laisser un avis Google » est ajouté automatiquement sous ta signature.
          </p>
        <% else %>
          <p class="text-xs text-ink-light mt-2 pl-3 border-l-2 border-border-warm">
            💡 Aucune demande d'avis n'est envoyée : la variable <code>GOOGLE_REVIEW_URL</code>
            n'est pas renseignée.
          </p>
        <% end %>
        <div class="flex items-center justify-between mt-5">
          <%= link_to "Annuler", admin_facture_path(@facture), class: "text-sm text-ink-light hover:text-ink" %>
          <%= submit_tag "✉️ Envoyer à #{@facture.client.email}", class: "btn-primary cursor-pointer",
                data: { turbo_confirm: "Confirmer l'envoi de la facture #{@facture.numero} à #{@facture.client.email} ?" } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
