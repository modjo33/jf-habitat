<% mois_fr = %w[_ janv. févr. mars avril mai juin juil. août sept. oct. nov. déc.] %>
<% jours_fr = %w[Lundi Mardi Mercredi Jeudi Vendredi Samedi Dimanche] %>
<% prev_sem = (@debut - 7).to_s %>
<% next_sem = (@debut + 7).to_s %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <div class="flex items-center gap-3">
    <h1 class="h-display text-2xl text-ink">
      Semaine du <%= @debut.day %> <%= mois_fr[@debut.month] %> au <%= @fin.day %> <%= mois_fr[@fin.month] %>
    </h1>
    <div class="flex items-center gap-1">
      <%= link_to "‹", semaine_admin_rdvs_path(date: prev_sem), class: "w-8 h-8 flex items-center justify-center rounded-lg border border-border-warm hover:bg-sand text-ink" %>
      <%= link_to "Cette semaine", semaine_admin_rdvs_path(date: Date.current), class: "px-3 h-8 flex items-center rounded-lg border border-border-warm hover:bg-sand text-xs font-semibold text-ink" %>
      <%= link_to "›", semaine_admin_rdvs_path(date: next_sem), class: "w-8 h-8 flex items-center justify-center rounded-lg border border-border-warm hover:bg-sand text-ink" %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <div class="flex rounded-lg border border-border-warm overflow-hidden text-xs font-semibold">
      <%= link_to "Mois", admin_rdvs_path(mois: @debut.strftime("%Y-%m")), class: "px-3 py-2 hover:bg-sand text-ink" %>
      <span class="px-3 py-2 bg-ink text-sand">Semaine</span>
    </div>
    <%= link_to "iCal ↗", ical_admin_rdvs_path, class: "px-3 py-2 rounded-lg border border-border-warm hover:bg-sand text-xs font-semibold text-ink" %>
    <%= link_to "+ Nouveau RDV", new_admin_rdv_path(date: Date.current), class: "btn-primary text-sm px-5 py-2.5" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-7 gap-2">
  <% @jours.each do |jour| %>
    <% aujourdhui = jour == Date.current %>
    <% rdvs_jour = @rdvs_par_jour[jour] || [] %>
    <div class="card-premium p-2 min-h-[220px] flex flex-col <%= 'ring-2 ring-accent/40' if aujourdhui %>"
         style="<%= rdv_cell_style(rdvs_jour, alpha: 0.12) %>">
      <div class="flex items-center justify-between px-1 pb-2 mb-1 border-b border-border-warm/60">
        <div class="text-xs">
          <span class="font-bold text-ink"><%= jours_fr[jour.cwday - 1] %></span>
          <span class="text-ink-light"><%= jour.day %></span>
        </div>
        <%= link_to "+", new_admin_rdv_path(date: jour), class: "text-ink-light/50 hover:text-accent leading-none px-1" %>
      </div>
      <div class="space-y-1.5 flex-1">
        <% rdvs_jour.each do |rdv| %>
          <% suite = rdv.multi_jour? && jour != rdv.jour %>
          <%= link_to edit_admin_rdv_path(rdv),
                style: "background:#{rdv.couleur};",
                class: "block rounded px-2 py-1.5 text-white shadow-sm #{'opacity-50 line-through' if rdv.statut == 'annule'}" do %>
            <div class="text-[11px] font-semibold opacity-90"><%= suite ? "↳ suite" : rdv.horaire %></div>
            <div class="text-xs font-bold leading-tight"><%= rdv.titre %></div>
            <% if rdv.client %><div class="text-[10px] opacity-90 truncate"><%= rdv.client.nom %></div><% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
