<div class="mb-6">
  <%= link_to admin_estimations_path, class: "inline-flex items-center gap-2 text-sm text-ink-light hover:text-ink mb-4" do %>
    ← Retour aux leads
  <% end %>
  <div class="flex items-start justify-between">
    <div>
      <h1 class="h-display text-4xl text-ink"><%= @estimation.nom %></h1>
      <div class="mt-1 flex items-center gap-3">
        <span class="font-mono text-xs text-accent font-semibold"><%= @estimation.reference %></span>
        <%= render "statut_badge", statut: @estimation.statut %>
        <span class="text-sm text-ink-light"><%= @estimation.created_at.strftime("%d/%m/%Y à %H:%M") %></span>
      </div>
    </div>

    <div class="flex flex-col items-end gap-2">
      <div class="flex gap-2">
        <%= link_to "📅 Planifier une visite", new_admin_rdv_path(estimation_id: @estimation.id), class: "btn-secondary text-sm px-4 py-2.5" %>
        <%= link_to "Devis assisté →", devis_admin_estimation_path(@estimation), class: "btn-secondary text-sm px-4 py-2.5" %>
        <%= link_to "Devis détaillé →", devis_lignes_admin_estimation_path(@estimation), class: "btn-primary text-sm px-5 py-2.5" %>
      </div>
      <%= form_with model: @estimation, url: admin_estimation_path(@estimation), method: :patch, class: "flex gap-2" do |f| %>
        <%= f.select :statut, Estimation::STATUTS.map { |s| [s.tr("_", " ").capitalize, s] }, {}, class: "input-field text-sm py-2" %>
        <%= f.submit "Mettre à jour", class: "btn-secondary text-sm px-4 py-2" %>
      <% end %>
    </div>
  </div>
</div>

<% if @estimation.devis_total.to_d.positive? %>
  <div class="mb-6 card-premium p-4 border border-accent/40 bg-accent-soft/40 flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="text-[11px] uppercase tracking-wider text-accent font-bold">Devis établi</div>
      <div class="font-display text-3xl text-ink"><%= eur(@estimation.devis_total) %></div>
      <div class="text-xs text-ink-light">TVA non applicable · le chiffrage web ci-dessous (<%= eur(@estimation.total_ttc) %>) est la première estimation en ligne du client.</div>
    </div>
    <% if @estimation.devis_lignes.exists? %>
      <%= link_to "Voir / modifier le devis →", devis_lignes_admin_estimation_path(@estimation), class: "btn-secondary text-sm px-5 py-2.5" %>
    <% else %>
      <%= link_to "Voir / modifier le devis →", devis_admin_estimation_path(@estimation), class: "btn-secondary text-sm px-5 py-2.5" %>
    <% end %>
  </div>
<% end %>

<div class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="card-premium p-6">
      <h2 class="font-display text-xl text-ink mb-4"><%= @estimation.devis_total.to_d.positive? ? "Estimation en ligne (indicative)" : "Prestations" %></h2>
      <div class="space-y-2">
        <% @estimation.estimation_lines.each do |line| %>
          <div class="flex items-center justify-between p-3 bg-sand rounded-lg">
            <div>
              <div class="font-semibold text-ink text-sm"><%= line.piece %> · <%= line.prestation_label %></div>
              <div class="text-xs text-ink-light"><%= line.gamme_label %> · <%= line.surface %> m² × <%= number_to_currency(line.prix_unitaire, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></div>
            </div>
            <div class="font-bold text-ink"><%= number_to_currency(line.total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></div>
          </div>
        <% end %>
      </div>
      <div class="mt-4 pt-4 border-t border-ink/10 space-y-1.5 text-sm">
        <div class="flex justify-between"><span class="text-ink-light">HT</span><span class="font-semibold"><%= number_to_currency(@estimation.total_ht, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span></div>
        <div class="flex justify-between"><span class="text-ink-light">TVA <%= @estimation.tva_taux %>%</span><span class="font-semibold"><%= number_to_currency(@estimation.total_ttc - @estimation.total_ht, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span></div>
        <% devis_present = @estimation.devis_total.to_d.positive? %>
        <div class="flex justify-between pt-2 border-t border-ink/10">
          <span class="<%= devis_present ? 'text-ink-light' : 'font-bold text-ink' %>">TTC<%= " (indicatif)" if devis_present %></span>
          <span class="<%= devis_present ? 'text-sm text-ink-light' : 'font-display text-2xl text-accent' %>"><%= number_to_currency(@estimation.total_ttc, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
        </div>
      </div>
    </div>

    <% if @estimation.message.present? %>
      <div class="card-premium p-6">
        <h2 class="font-display text-xl text-ink mb-3">Message du client</h2>
        <p class="text-ink-soft leading-relaxed whitespace-pre-wrap"><%= @estimation.message %></p>
      </div>
    <% end %>
  </div>

  <div class="space-y-6">
    <div class="card-premium p-6">
      <h2 class="font-display text-xl text-ink mb-4">Contact</h2>
      <dl class="space-y-3 text-sm">
        <div><dt class="text-xs uppercase tracking-wider text-ink-light font-semibold">Email</dt><dd><a href="mailto:<%= @estimation.email %>" class="text-accent hover:underline"><%= @estimation.email %></a></dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-ink-light font-semibold">Téléphone</dt><dd><a href="tel:<%= @estimation.telephone %>" class="text-accent hover:underline"><%= @estimation.telephone %></a></dd></div>
        <% if @estimation.adresse.present? %>
          <div><dt class="text-xs uppercase tracking-wider text-ink-light font-semibold">Adresse chantier</dt><dd><%= @estimation.adresse %><br><%= @estimation.code_postal %> <%= @estimation.ville %></dd></div>
        <% end %>
        <div><dt class="text-xs uppercase tracking-wider text-ink-light font-semibold">Type de chantier</dt><dd><%= @estimation.type_chantier_label %></dd></div>
        <div><dt class="text-xs uppercase tracking-wider text-ink-light font-semibold">Délai</dt><dd><%= @estimation.delai_label %></dd></div>
      </dl>
    </div>

    <%= button_to "Supprimer ce lead", admin_estimation_path(@estimation), method: :delete, data: { turbo_confirm: "Supprimer définitivement ce lead ?" }, class: "w-full text-sm text-red-600 hover:bg-red-50 px-4 py-2 rounded-lg border border-red-200" %>
  </div>
</div>
