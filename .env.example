# =============================================================================
# JF Habitat — variables d'environnement
# Copier en .env (dev) ou les injecter sur le serveur de prod (Kamal secrets, etc.)
# =============================================================================

# --- Rails ---
RAILS_MASTER_KEY=
JF_HABITAT_DATABASE_PASSWORD=
APP_HOST=jfhabitat.fr
ALT_HOSTS=

# --- Admin (HTTP basic auth /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_strong_password

# --- SMTP (recommandé : Resend — gratuit < 3000 mails/mois) ---
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM=contact@jfhabitat.fr
LEAD_NOTIFICATION_EMAIL=contact@jfhabitat.fr

# --- Cal.com (RDV, optionnel) ---
CAL_COM_URL=

# --- Twilio SMS (optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_PHONE_NUMBER=

# --- Analytics (gratuit, à brancher après création des comptes) ---
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Infos business (alimente Schema.org, contact, mentions légales) ---
BUSINESS_PHONE=
BUSINESS_EMAIL=contact@jfhabitat.fr
BUSINESS_STREET=
BUSINESS_CITY=
BUSINESS_POSTAL_CODE=
BUSINESS_AREA=Île-de-France
BUSINESS_HOURS=Lundi au vendredi · 8h–18h
FACEBOOK_URL=
INSTAGRAM_URL=
LINKEDIN_URL=

# --- Mentions légales (raison sociale, SIRET, etc.) ---
LEGAL_COMPANY_NAME=
LEGAL_LEGAL_FORM=
LEGAL_SIRET=
LEGAL_ADDRESS=
LEGAL_EMAIL=contact@jfhabitat.fr
LEGAL_PHONE=
LEGAL_DIRECTOR=
LEGAL_VAT=Non applicable, art. 293 B du CGI (franchise en base)

# --- Hébergeur (apparait dans mentions légales) ---
HOSTING_PROVIDER=Hetzner Online GmbH
HOSTING_ADDRESS=Industriestr. 25, 91710 Gunzenhausen, Allemagne
HOSTING_WEBSITE=https://www.hetzner.com

# --- Médiation consommation (obligatoire pour artisan B2C) ---
MEDIATEUR_NAME=
MEDIATEUR_URL=
